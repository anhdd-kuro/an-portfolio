---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Thuy An | イラストレーター & UIデザイナー";
const description = "Portfolio of Thuy An – illustrator and UI/UX designer based in Fukuoka, Japan.";
const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="ja" page="home" title={title} description={description} ogImage={ogImage} divider={false}>

    <h1 class="sr-only">Thuy An – Illustrator &amp; UI Designer</h1>

    <!-- ===== HERO BANNER ===== -->
    <section aria-label="Bookshelf – pick a book to explore">
      <!-- Tablet / desktop banner -->
      <div class="hidden mb:block relative w-full bg-white">
        <img src="/assets/images/banner.webp" alt="Hand-drawn bookshelf – pick a book to explore" class="block w-full h-auto" width="1920" height="1467" fetchpriority="high">
        <a href="/jp/about" class="hot" style="left:68.6719%;top:1.5337%;width:20.3906%" aria-label="自己紹介" title="自己紹介">
          <img class="hot-still" src="/assets/images/still-about-pc.png" alt="" width="261" height="169" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-about-pc.gif" data-gif="/assets/images/hover-about-pc.gif" alt="" width="261" height="169" loading="lazy" decoding="async">
        </a>
        <a href="/jp/ui-design" class="hot" style="left:47.8125%;top:15.4397%;width:16.0156%" aria-label="UIデザイン" title="UIデザイン">
          <img class="hot-still" src="/assets/images/still-uidesign-pc.png" alt="" width="205" height="187" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-uidesign-pc.gif" data-gif="/assets/images/hover-uidesign-pc.gif" alt="" width="205" height="187" loading="lazy" decoding="async">
        </a>
        <a href="/jp/illustration" class="hot" style="left:32.6562%;top:31.6973%;width:25.2344%" aria-label="イラスト" title="イラスト">
          <img class="hot-still" src="/assets/images/still-illustration-pc.png" alt="" width="323" height="165" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-illustration-pc.gif" data-gif="/assets/images/hover-illustration-pc.gif" alt="" width="323" height="165" loading="lazy" decoding="async">
        </a>
        <a href="/jp/contact" class="hot" style="left:7.5%;top:47.955%;width:17.9688%" aria-label="お問い合わせ" title="お問い合わせ">
          <img class="hot-still" src="/assets/images/still-contact-pc.png" alt="" width="230" height="164" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-contact-pc.gif" data-gif="/assets/images/hover-contact-pc.gif" alt="" width="230" height="164" loading="lazy" decoding="async">
        </a>
      </div>
      <!-- Mobile banner -->
      <div class="mb:hidden relative w-full bg-white">
        <img src="/assets/images/banner-mobile.webp" alt="Hand-drawn bookshelf – pick a book to explore" class="block w-full h-auto" width="750" height="1548" fetchpriority="high">
        <a href="/jp/about" class="hot" style="left:29.8667%;top:10.9819%;width:37.8667%" aria-label="自己紹介" title="自己紹介">
          <img class="hot-still" src="/assets/images/still-about-sp.png" alt="" width="284" height="181" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-about-sp.gif" data-gif="/assets/images/hover-about-sp.gif" alt="" width="284" height="181" loading="lazy" decoding="async">
        </a>
        <a href="/jp/ui-design" class="hot" style="left:49.3333%;top:28.876%;width:27.4667%" aria-label="UIデザイン" title="UIデザイン">
          <img class="hot-still" src="/assets/images/still-uidesign-sp.png" alt="" width="206" height="188" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-uidesign-sp.gif" data-gif="/assets/images/hover-uidesign-sp.gif" alt="" width="206" height="188" loading="lazy" decoding="async">
        </a>
        <a href="/jp/illustration" class="hot" style="left:6.9333%;top:46.9638%;width:46.6667%" aria-label="イラスト" title="イラスト">
          <img class="hot-still" src="/assets/images/still-illustration-sp.png" alt="" width="350" height="177" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-illustration-sp.gif" data-gif="/assets/images/hover-illustration-sp.gif" alt="" width="350" height="177" loading="lazy" decoding="async">
        </a>
        <a href="/jp/contact" class="hot" style="left:3.0667%;top:65.6331%;width:33.2%" aria-label="お問い合わせ" title="お問い合わせ">
          <img class="hot-still" src="/assets/images/still-contact-sp.png" alt="" width="249" height="177" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-contact-sp.gif" data-gif="/assets/images/hover-contact-sp.gif" alt="" width="249" height="177" loading="lazy" decoding="async">
        </a>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section aria-labelledby="about-h" class="flex flex-col items-center pt-[136px] px-6 mb:flex-row mb:flex-wrap mb:gap-10 mb:px-12 mb:pt-[160px] mb:items-start dt:gap-[79px] dt:px-[84px] dt:pt-[196px]">
      <h2 id="about-h" class="sr-only">About me</h2>
      <img src="/assets/images/aboutme.png" alt="About me" class="w-[200px] max-w-full h-auto object-contain mb:w-[280px] mb:h-[300px] mb:shrink-0 dt:w-[383px] dt:h-[400px]" loading="lazy">
      <div class="w-full mb:w-auto mb:max-w-[650px] mb:flex-1 mb:basis-[300px] mb:min-w-0 mb:pt-10 dt:basis-[380px] dt:pt-[84px]">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:mt-0">トゥイ・アンです。イラストレーター兼UIデザイナーとして活動していて、現在は日本の福岡に住んでいます。<br><br>絵を描いたりデザインをしたりする仕事を、もうかなり長く続けています。以前は主にイラストや書籍の装丁を手がけていましたが、最近はUIデザインにも取り組むようになりました。絵を描くこと、絵本を集めること、コーヒー、猫、そして書店をぶらぶらしながらアイデアを探すことが好きで、頭の中にあるアイデアを実際の絵にする瞬間はいつもとても楽しいです。<br><br>もしあなたも同じように感じるなら、ぜひお会いできたら嬉しいです！</p>
        <a href="/jp/about" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8" style="background-image:url(/assets/images/readmore.png)" aria-label="もっと見る" title="もっと見る"></a>
      </div>
    </section>

    <!-- ===== ILLUSTRATION ===== -->
    <section aria-labelledby="illus-h" class="flex flex-col items-center pt-[152px] px-6 mb:flex-row-reverse mb:flex-wrap mb:gap-14 mb:px-[60px] mb:pt-[168px] mb:justify-center mb:items-start dt:grid dt:grid-cols-2">
      <h2 id="illus-h" class="sr-only">Illustration</h2>
      <div class="flex flex-col items-center w-full mb:w-[492px] mb:max-w-full dt:w-full dt:max-w-[492px] dt:justify-self-end">
        <img src="/assets/images/illus.png" alt="Illustration" class="w-[220px] max-w-full h-auto object-contain mb:w-full mb:h-[400px]" loading="lazy">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:text-justify mb:mt-10">イラストの経験は約8年で、ベトナムの出版社との仕事も多く手がけてきました。また、自分の絵本を自主出版しています。皆さんに楽しんでいただけたら、とても嬉しいです！</p>
        <a href="/jp/illustration" class="img-btn block w-[138px] h-[64px] mx-auto mt-8 hidden dt:block" style="background-image:url(/assets/images/readmore.png)" aria-label="もっと見る" title="もっと見る"></a>
      </div>
      <div class="w-full max-w-[320px] mt-10 mb:w-[632px] mb:max-w-full mb:mt-0 dt:w-full dt:order-first">
        <div class="grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8">
          <a href="/jp/artwork" class="block group"><img src="/assets/images/work/70338b4f401c.webp" alt="パーソナルワーク" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">パーソナルワーク</div></a>
          <a href="/jp/watermelon-seed" class="block group"><img src="/assets/images/work/4aa20ea3d416.webp" alt="Accidentally swallowed the watermelon seed" width="1177" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Accidentally swallowed the watermelon seed</div></a>
          <a href="/jp/lights-adventure" class="block group"><img src="/assets/images/work/e003c4d3bcb7.webp" alt="Light's Adventure" width="1200" height="1066" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Light's Adventure</div></a>
          <a href="/jp/happy-flight" class="block group"><img src="/assets/images/work/95b49d0f1af8.webp" alt="Happy flight" width="786" height="974" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Happy flight</div></a>
        </div>
        <a href="/jp/illustration" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8 dt:hidden" style="background-image:url(/assets/images/readmore.png)" aria-label="もっと見る" title="もっと見る"></a>
      </div>
    </section>

    <!-- ===== UI DESIGN ===== -->
    <section aria-labelledby="ui-h" class="flex flex-col items-center pt-[176px] px-6 mb:flex-row-reverse mb:flex-wrap mb:gap-14 mb:px-[60px] mb:pt-[200px] mb:justify-center mb:items-start dt:grid dt:grid-cols-2">
      <h2 id="ui-h" class="sr-only">UI design</h2>
      <div class="flex flex-col items-center w-full mb:w-[479px] mb:max-w-full dt:w-full dt:max-w-[479px] dt:justify-self-start">
        <img src="/assets/images/uidesign.png" alt="UI design" class="w-[220px] max-w-full h-auto object-contain mb:w-full mb:h-[400px]" loading="lazy">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:text-justify mb:mt-10">UIデザインの経験は約3年です。TikTok、小規模ブランド、そして日本企業での案件に携わってきました。クライアントとの直接のやり取りや、職種をまたいだチームとの協働も経験しています。</p>
        <a href="/jp/ui-design" class="img-btn block w-[138px] h-[64px] mx-auto mt-8 hidden dt:block" style="background-image:url(/assets/images/readmore.png)" aria-label="もっと見る" title="もっと見る"></a>
      </div>
      <div class="w-full max-w-[320px] mt-10 mb:w-[632px] mb:max-w-full mb:mt-0 dt:w-full">
        <div class="grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8">
          <a href="/jp/tiktok-camp" class="block group"><img src="/assets/images/projects/tiktok-camp/thumb.webp" alt="TikTok キャンペーン - UI デザイン" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">TikTok キャンペーン - UI デザイン</div></a>
          <a href="/jp/top-member-page" class="block group"><img src="/assets/images/projects/top-member-page/thumb.webp" alt="会員トップページ - LP デザイン" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">会員トップページ - LP デザイン</div></a>
          <a href="/jp/offshore" class="block group"><img src="/assets/images/projects/offshore/thumb.webp" alt="オフショア - LP デザイン" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">オフショア - LP デザイン</div></a>
          <a href="/jp/lucky-money" class="block group"><img src="/assets/images/projects/lucky-money/thumb.webp" alt="お年玉 - LP デザイン" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">お年玉 - LP デザイン</div></a>
        </div>
        <a href="/jp/ui-design" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8 dt:hidden" style="background-image:url(/assets/images/readmore.png)" aria-label="もっと見る" title="もっと見る"></a>
      </div>
    </section>

    <!-- ===== CONTACT TEASER ===== -->
    <section aria-labelledby="contact-h" class="pt-[200px] flex flex-col items-center">
      <h2 id="contact-h" class="sr-only">Contact</h2>
      <img src="/assets/images/contact.png" alt="Contact" class="w-[280px] max-w-[60%] mb:w-[340px] mb:max-w-full dt:w-[387px] h-auto object-contain" loading="lazy">
      <p class="mt-12 max-w-[880px] px-6 text-center font-normal text-[16px] leading-6 text-pretty">はじめまして、Thuy Anです。描くこと、デザインすること、そしてアイデアを人に楽しんでもらえる形にすることが好きなイラストレーター兼UIデザイナーです。いつも好奇心を持ち、いつも何かを作り、いつも新しい物語を探しています。<br><br><strong>一緒に良いものを作りましょう。アイデアがあれば、ぜひお気軽にご連絡ください！<br>Email : <a href="mailto:nguyenan19495@gmail.com" class="underline">nguyenan19495@gmail.com</a></strong></p>
      <div class="h-[79px]" aria-hidden="true"></div>
    </section>
  
</BaseLayout>
