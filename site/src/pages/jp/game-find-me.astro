---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "game find me | Thuy An Portfolio";
const description = "Caeruxlab 在籍中に担当したプロジェクトです。";
const ogImage = "/assets/images/projects/game-find-me/cover.webp";
---
<BaseLayout lang="ja" page="game-find-me" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">game find me</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">Caeruxlab 在籍中に担当したプロジェクトです。</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">カテゴリー : モバイルゲーム UI デザイン<br>クライアント : Caeruxlab<br>使用ツール : Adobe XD, Adobe Illustrator</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">作品</h2>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 dt:grid-cols-3 gap-8 mb:gap-10 justify-items-center items-start">
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/01.webp" alt="Screen 1" width="800" height="1747" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/02.webp" alt="Screen 2" width="800" height="1752" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/03.webp" alt="Screen 3" width="800" height="1748" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/04.webp" alt="Screen 4" width="800" height="1746" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/05.webp" alt="Screen 5" width="800" height="1746" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/06.webp" alt="Screen 6" width="800" height="1764" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/07.webp" alt="Screen 7" width="800" height="1744" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/08.webp" alt="Screen 8" width="800" height="1741" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/09.webp" alt="Screen 9" width="800" height="1749" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/10.webp" alt="Screen 10" width="800" height="1748" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-find-me/11.webp" alt="Screen 11" width="800" height="1745" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">
        <div class="w-full mx-auto" style="max-width:312px"><img src="/assets/images/projects/game-find-me/12.webp" alt="Characters" width="624" height="590" class="block w-full h-auto" loading="lazy" decoding="async"></div>
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">ご覧いただき、ありがとうございました！</p>
      </div>

      <a href="/jp/ui-design" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="もどる" title="もどる"></a>
    </article>
  
</BaseLayout>
