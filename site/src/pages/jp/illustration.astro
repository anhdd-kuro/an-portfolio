---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "イラスト | Thuy An Portfolio";

const description = "Illustration portfolio of Thuy An – picture books, book covers and hand-drawn artwork.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="ja" page="illustration" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-12 dt:px-20 pt-8 mb:pt-[46px]">
      <h1 class="sr-only">Illustration</h1>
      <section class="flex flex-col items-center mb:flex-row mb:flex-wrap gap-8 mb:gap-[78px] mb:items-center" aria-label="Introduction">
        <img src="/assets/images/illus.png" alt="Illustration" class="block h-[173px] mb:h-[315px] w-auto max-w-full object-contain shrink-0" width="1067" height="867">
        <p class="text-body text-left mb:text-justify max-w-[550px] min-w-0 mb:flex-1 mb:basis-[360px] text-pretty">イラストの経験は約8年で、ベトナムの出版社との仕事も多く手がけてきました。また、自分の絵本を自主出版しています。皆さんに楽しんでいただけたら、とても嬉しいです！</p>
      </section>

      <section class="mt-16 grid grid-cols-1 justify-items-center mb:grid-cols-[repeat(auto-fit,300px)] mb:justify-items-stretch justify-center gap-y-[60px] gap-x-[50px]" aria-label="Illustration projects">
        <h2 class="sr-only">Projects</h2>
        <a href="/jp/artwork" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/70338b4f401c.webp" alt="パーソナルワーク" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">パーソナルワーク</div></a>
        <a href="/jp/watermelon-seed" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/4aa20ea3d416.webp" alt="スイカのたねを食べちゃったら。。。" width="1177" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">スイカのたねを食べちゃったら。。。</div></a>
        <a href="/jp/lights-adventure" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/e003c4d3bcb7.webp" alt="ひかりのぼうけん" width="1200" height="1066" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">ひかりのぼうけん</div></a>
        <a href="/jp/happy-flight" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/95b49d0f1af8.webp" alt="ハッピーフライト" width="786" height="974" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">ハッピーフライト</div></a>
        <a href="/jp/hasu-shorts" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/11aef93cb9b1.webp" alt="Hasuの半ズボン" width="1184" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasuの半ズボン</div></a>
        <a href="/jp/hasu-gardening" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/dbcd3708f4f3.webp" alt="Hasuのガーデニング" width="1184" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasuのガーデニング</div></a>
        <a href="/jp/hasu-camping" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/f6f19e2e7c3a.webp" alt="Hasuのキャンプ" width="1166" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasuのキャンプ</div></a>
        <a href="/jp/hasu-guessing-game" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/04cb46a26902.webp" alt="Hasuの絵当てゲーム" width="1197" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasuの絵当てゲーム</div></a>
        <a href="/jp/book-cover-design" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/d952af45a500.webp" alt="ブックカバーデザイン" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">ブックカバーデザイン</div></a>
        <a href="/jp/asahi" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/asahi-thumb.webp" alt="Asahiプロジェクト" width="1400" height="1224" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Asahiプロジェクト</div></a>
        <a href="/jp/kaeru-sticker" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/1a7133ed05e9.webp" alt="Kaeruスタンプのイラストデザイン" width="998" height="964" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Kaeruスタンプのイラストデザイン</div></a>
        <a href="/jp/doa-hoa-dong-thoai" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/doa-hoa-dong-thoai/thumb.webp" alt="Đóa hoa đồng thoại - 物語の挿絵" width="900" height="900" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Đóa hoa đồng thoại - 物語の挿絵</div></a>
        <a href="/jp/tarot" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/tarot/thumb.webp" alt="タロットのイラスト" width="900" height="900" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">タロットのイラスト</div></a>
      </section>

      <div class="h-[100px]" aria-hidden="true"></div>
    </div>
  
</BaseLayout>
