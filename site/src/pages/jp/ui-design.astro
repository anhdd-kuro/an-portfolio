---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "UI/UX Design | Thuy An Portfolio";

const description = "UI/UX design portfolio of Thuy An – web, landing page and app UI projects.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="ja" page="ui-design" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-12 dt:px-20 pt-8 mb:pt-[46px]">
      <h1 class="sr-only">UI/UX Design</h1>
      <section class="flex flex-col items-center mb:flex-row mb:flex-wrap gap-8 mb:gap-[78px] mb:items-center" aria-label="Introduction">
        <img src="/assets/images/uidesign.png" alt="UI design" class="block h-[175px] mb:h-[317px] w-auto max-w-full object-contain shrink-0" width="949" height="793">
        <p class="text-body text-left mb:text-justify max-w-[550px] min-w-0 mb:flex-1 mb:basis-[360px] text-pretty">UIデザインの経験は約3年です。TikTok、小規模ブランド、そして日本企業での案件に携わってきました。クライアントとの直接のやり取りや、職種をまたいだチームとの協働も経験しています。</p>
      </section>
      <section class="mt-16 grid grid-cols-1 justify-items-center mb:grid-cols-[repeat(auto-fit,300px)] mb:justify-items-stretch justify-center gap-y-[60px] gap-x-[50px]" aria-label="UI/UX projects">
        <h2 class="sr-only">Projects</h2>
        <a href="/jp/tiktok-camp" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/tiktok-camp/thumb.webp" alt="Tiktok - UIデザインキャンペーン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Tiktok - UIデザインキャンペーン</div></a>
        <a href="/jp/top-member-page" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/top-member-page/thumb.webp" alt="Top member page - LP デザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Top member page - LP デザイン</div></a>
        <a href="/jp/offshore" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/offshore/thumb.webp" alt="オフショア - LP デザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">オフショア - LP デザイン</div></a>
        <a href="/jp/lucky-money" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/lucky-money/thumb.webp" alt="お年玉 - LP デザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">お年玉 - LP デザイン</div></a>
        <a href="/jp/trust-group" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/trust-group/thumb.webp" alt="Trust group - HP デザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Trust group - HP デザイン</div></a>
        <a href="/jp/matching-app" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/matching-app/thumb.webp" alt="マッチングアプリ - モバイルアプリデザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">マッチングアプリ - モバイルアプリデザイン</div></a>
        <a href="/jp/kagu-page" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/kagu-page/thumb.webp" alt="家具 Kagu - EC デザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">家具 Kagu - EC デザイン</div></a>
        <a href="/jp/bento-recipe" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/bento-recipe/thumb.webp" alt="お弁当レシピ - LP デザイン ＆ アプリデザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">お弁当レシピ - LP デザイン ＆ アプリデザイン</div></a>
        <a href="/jp/game-find-me" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/game-find-me/thumb.webp" alt="Game Find me" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Game Find me</div></a>
        <a href="/jp/game-jump" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/game-jump/thumb.webp" alt="Game Jump" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Game Jump</div></a>
        <a href="/jp/yoseka" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/yoseka/thumb.webp" alt="Yosekaプロジェクト - App themme design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Yosekaプロジェクト - App themme design</div></a>
        <a href="/jp/ketnoi" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/ketnoi/thumb.webp" alt="Ketnoi - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Ketnoi - LP design</div></a>
        <a href="/jp/waveland" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/waveland/thumb.webp" alt="Waveland - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Waveland - LP design</div></a>
        <a href="/jp/qwiq-logo" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/qwiq-logo/thumb.webp" alt="Qwiqのロゴデザイン" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Qwiqのロゴデザイン</div></a>
      </section>
      <div class="h-[100px]" aria-hidden="true"></div>
    </div>
  
</BaseLayout>
