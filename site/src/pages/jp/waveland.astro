---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Waveland - LP design | Thuy An Portfolio";

const description = "This is a project that I worked on while at Caeruxlab company.";

const ogImage = "/assets/images/projects/waveland/thumb.webp";
---
<BaseLayout lang="ja" page="waveland" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Waveland - LP design</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">Caeruxlab 在籍中に担当したプロジェクトです。</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">カテゴリー : ホームページデザイン<br>クライアント : Caeruxlab<br>使用ツール : Adobe XD, Figma</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">作品</h2>
        <div class="grid grid-cols-1 gap-10 mb:gap-[50px] items-start">
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/waveland/s01.webp" alt="Screen 1" width="3222" height="2379" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/waveland/s02.webp" alt="Screen 2" width="3222" height="2379" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/waveland/s03.webp" alt="Screen 3" width="3222" height="2379" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/waveland/s04.webp" alt="Screen 4" width="3222" height="2373" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">ご覧いただき、ありがとうございました！</p>
      </div>

      <a href="/jp/ui-design" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="もどる" title="もどる"></a>
    </article>

</BaseLayout>
