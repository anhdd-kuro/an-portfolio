---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "About me | Thuy An Portfolio";
const description = "About Thuy An – illustrator and UI designer from Vietnam based in Fukuoka: employment overview, work experience and design skills.";
const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="ja" page="about" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-16 dt:px-[140px] pt-10 mb:pt-[66px]">
      <h1 class="sr-only">About me</h1>
      <img src="/assets/images/aboutme.png" alt="About me – hand-drawn portrait" class="block h-[189px] mb:h-[343px] w-auto max-w-full object-contain mx-auto" width="848" height="886">
      <div class="mt-[52px] flex flex-col gap-7">
      <section>
        <h2 class="font-extrabold text-[18px] mb-2">【勤務先概要】</h2>
        <p class="text-[16px] leading-[22px] font-normal text-pretty">・大学生でいながら、インターンとして、チラシ、ポスターなど２Dグラフィックデザインを担当しました<br>・自作でお年玉、ハガキなどをデザインし、売りました<br>・フリーランスとしてベトナムである様々な出版社の受注を受けて、デジタルや手描きで仕事しました<br>・中国の漫画系の出版社の受注を受けて、友達とスタジオを立てて、スタートアップし、漫画の彩色の仕事を担当しました<br>・CaeruxLab会社でイラストレーターやUIUXデザインを担当しています</p>
      </section>
      <section>
        <h2 class="font-extrabold text-[18px] mb-2">【職務経歴】</h2>
        <p class="text-[16px] leading-[22px] font-normal text-pretty">・〜2018年06月<br>ベトナムにあるデザイン会社でインターン<br>仕事相手：ベトナム会社<br>仕事内容：チラシ、ポスターなど２Dグラフィックデザインを担当しました<br>チームの人数：一人で<br>利用ソフト：Photoshop , Illustrator<br><br>・2018年10月〜2019年４月<br>スタートアップで、中国会社から受注を受けて友達とスタートアップしました<br>仕事相手：中国漫画会社<br>仕事内容：ネームから、原稿にし、彩色し、完成版にすること<br>チームの人数：６人<br>リーダーとして、仕事のタスクの割り振りや品質管理、描くことまで担当しました<br>利用ソフト：Photoshop , Illustrator<br><br>・2019年04月〜2022年03月<br>日本語学校院へ通いながら、リモートワークでフリーランスをやる<br>仕事相手：ベトナムにある出版社<br>仕事内容：原稿を受けて、絵本にすること<br>チームの人数：一人で<br>利用ソフト：Photoshop , Illustrator<br><br>・2022年03月〜2024年12月<br>CaeruxLab会社でデザイナーとして働いている<br>仕事内容：UIUXデザイン、ミニゲームをデザインする<br>利用ソフト：Photoshop , Illustrator, Xd adobe, Figma<br><br>・2025年01月〜現在<br>株式会社 カエルエックス（本社）と業務委託契約を結びデザイナーとして働いている<br>仕事内容：UIUXデザイン、イラストをデザインする<br>利用ソフト：Photoshop , Illustrator, Xd adobe, Figma</p>
      </section>
      <section>
        <h2 class="font-extrabold text-[18px] mb-2">【デザイナーとしてのスキル】</h2>
        <p class="text-[16px] leading-[22px] font-normal text-pretty">・Photoshop ( 実際経験：8年間ぐらい )<br>・Illustrator ( 実際経験：8年間ぐらい )<br>・Adobe XD ( 実際経験：3年ぐらい )<br>・Figma ( 実際経験：2年ぐらい )<br>・手描き</p>
      </section>
      </div>
    </div>
    <div class="h-[100px] mb:h-[173px]" aria-hidden="true"></div>
  
</BaseLayout>
