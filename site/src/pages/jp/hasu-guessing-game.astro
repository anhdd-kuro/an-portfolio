---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Hasu playing a guessing game | Thuy An Portfolio";
const description = "This ehon book is part of a series of 4 books that revolve around the boy named Hasu and his adventures. The content of this book was edited by Trang ";
const ogImage = "/assets/images/work/fd28fdd43dc0.webp";
---
<BaseLayout lang="ja" page="hasu-guessing-game" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/fd28fdd43dc0.webp" alt="Cover" width="1760" height="1414" class="block w-full h-[240px] mb:h-[360px] dt:h-[460px] object-cover object-center" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Hasu playing a guessing game - 2019</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">イラスト：Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">この絵本は、ハスという男の子とその冒険を描いた全4巻シリーズの一冊です。文章は Trang Kyu が担当し、イラストを私が担当しました。</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">作品</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/edb7c84230b5.webp" alt="Artwork 1" width="1197" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/ad3c1468575e.webp" alt="Artwork 2" width="1200" height="1178" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/370cf1e6eeef.webp" alt="Artwork 3" width="1180" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/be40ab67233d.webp" alt="Artwork 4" width="1200" height="1199" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/69fcb160849f.webp" alt="Artwork 5" width="1200" height="1161" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/0d71d821ab8b.webp" alt="Artwork 6" width="1200" height="1155" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/d3bef83a1946.webp" alt="Artwork 7" width="1194" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/9f900cccfd1e.webp" alt="Artwork 8" width="1190" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/b34597e7750d.webp" alt="Artwork 9" width="1186" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/712e1c813667.webp" alt="Artwork 10" width="1196" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/2bbd12415e9c.webp" alt="Artwork 11" width="1200" height="1166" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/1b277e51bbcd.webp" alt="Artwork 12" width="1200" height="1177" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/d1195a7206a0.webp" alt="Artwork 13" width="1200" height="1191" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/c08e2912b134.webp" alt="Artwork 14" width="1199" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/550983f82fc1.webp" alt="Artwork 15" width="1173" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">
        <img src="/assets/images/work/110cc79a65b3.webp" alt="Closing illustration" width="664" height="662" class="block w-[200px] h-[200px] mb:w-[250px] mb:h-[250px] rounded-full object-cover object-center mx-auto" loading="lazy" decoding="async">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">ご覧いただき、ありがとうございました！</p>
      </div>

      <a href="/jp/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="もどる" title="もどる"></a>
    </article>
  
</BaseLayout>
