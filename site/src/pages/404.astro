---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Page not found | Thuy An Portfolio";

const description = "The page you are looking for does not exist.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="en" page="404" title={title} description={description} ogImage={ogImage} divider={true}>

    <section class="px-6 pt-16 pb-24 flex flex-col items-center text-center">
      <img src="/assets/images/aboutme.png" alt="" class="w-[220px] max-w-[60%] object-contain">
      <h1 class="mt-10 font-extrabold text-[32px] leading-10">404</h1>
      <p class="mt-3 text-body-loose">Oops, this page doesn’t exist.</p>
      <a href="/en" class="img-btn block w-[136px] h-[26px] mt-10 !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Home" title="Home"></a>
    </section>
  
</BaseLayout>
