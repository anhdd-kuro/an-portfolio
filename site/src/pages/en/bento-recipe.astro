---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Bento recipe - LP | App design | Thuy An Portfolio";

const description = "This is a project that I worked on while at Caeruxlab company.";

const ogImage = "/assets/images/projects/bento-recipe/thumb.webp";
---
<BaseLayout lang="en" page="bento-recipe" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Bento recipe - LP | App design</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">This is a project that I worked on while at Caeruxlab company.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Category : LP mobile design &amp; App design<br>Client : Caeruxlab<br>Tool used : Adobe XD</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 gap-10 mb:gap-[50px] items-start">
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/bento-recipe/01.webp" alt="Screen 1" width="2400" height="1768" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/bento-recipe/03.webp" alt="Screen 3" width="2400" height="1768" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/bento-recipe/04.webp" alt="Screen 4" width="2400" height="1768" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/bento-recipe/05.webp" alt="Screen 5" width="2400" height="1767" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/ui-design" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
  
</BaseLayout>
