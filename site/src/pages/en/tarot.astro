---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Tarot | Thuy An Portfolio";
const description = "A set of hand-drawn Major Arcana tarot card illustrations.";
const ogImage = "/assets/images/projects/tarot/thumb.webp";
---
<BaseLayout lang="en" page="tarot" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Tarot</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">Illustration : Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">A set of hand-drawn Major Arcana tarot card illustrations.</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 mb:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/00-cover.webp" alt="Tarot" width="1920" height="1920" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/01-the-fool.webp" alt="The Fool" width="1785" height="2526" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/02-the-magician.webp" alt="The Magician" width="595" height="842" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/03-the-empress.webp" alt="The Empress" width="595" height="842" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/04-the-emperor.webp" alt="The Emperor" width="595" height="842" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/05-the-hierophant.webp" alt="The Hierophant" width="595" height="842" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/06-justice.webp" alt="Justice" width="595" height="842" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/projects/tarot/07-the-hermit.webp" alt="The Hermit" width="595" height="842" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>

</BaseLayout>
