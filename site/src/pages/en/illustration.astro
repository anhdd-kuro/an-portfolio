---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Illustration | Thuy An Portfolio";

const description = "Illustration portfolio of Thuy An – picture books, book covers and hand-drawn artwork.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="en" page="illustration" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-12 dt:px-20 pt-8 mb:pt-[46px]">
      <h1 class="sr-only">Illustration</h1>
      <section class="flex flex-col items-center mb:flex-row mb:flex-wrap gap-8 mb:gap-[78px] mb:items-center" aria-label="Introduction">
        <img src="/assets/images/illus.png" alt="Illustration" class="block h-[173px] mb:h-[315px] w-auto max-w-full object-contain shrink-0" width="1067" height="867">
        <p class="text-body text-left mb:text-justify max-w-[550px] min-w-0 mb:flex-1 mb:basis-[360px] text-pretty">I have around 8 years of experience in illustration, including the opportunity to work with publishers in Vietnam. I have also independently published my own book. I would be extremely grateful if everyone enjoys it!</p>
      </section>

      <section class="mt-16 grid grid-cols-1 justify-items-center mb:grid-cols-[repeat(auto-fit,300px)] mb:justify-items-stretch justify-center gap-y-[60px] gap-x-[50px]" aria-label="Illustration projects">
        <h2 class="sr-only">Projects</h2>
        <a href="/en/artwork" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/70338b4f401c.webp" alt="My artwork" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">My artwork</div></a>
        <a href="/en/watermelon-seed" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/4aa20ea3d416.webp" alt="Accidentally swallowed the watermelon seed" width="1177" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Accidentally swallowed the watermelon seed</div></a>
        <a href="/en/lights-adventure" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/e003c4d3bcb7.webp" alt="Light's Adventure" width="1200" height="1066" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Light's Adventure</div></a>
        <a href="/en/happy-flight" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/95b49d0f1af8.webp" alt="Happy flight" width="786" height="974" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Happy flight</div></a>
        <a href="/en/hasu-shorts" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/11aef93cb9b1.webp" alt="Hasu wearing shorts" width="1184" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu wearing shorts</div></a>
        <a href="/en/hasu-gardening" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/dbcd3708f4f3.webp" alt="Hasu doing gardening" width="1184" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu doing gardening</div></a>
        <a href="/en/hasu-camping" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/f6f19e2e7c3a.webp" alt="Hasu goes camping" width="1166" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu goes camping</div></a>
        <a href="/en/hasu-guessing-game" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/04cb46a26902.webp" alt="Hasu playing a guessing game" width="1197" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu playing a guessing game</div></a>
        <a href="/en/book-cover-design" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/d952af45a500.webp" alt="Book cover design" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Book cover design</div></a>
        <a href="/en/asahi" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/asahi-thumb.webp" alt="Asahi" width="1400" height="1224" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Asahi</div></a>
        <a href="/en/kaeru-sticker" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/1a7133ed05e9.webp" alt="Kaeru sticker" width="998" height="964" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Kaeru sticker</div></a>
        <a href="/en/doa-hoa-dong-thoai" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/doa-hoa-dong-thoai/thumb.webp" alt="Đóa hoa đồng thoại - minh họa trang sách" width="900" height="900" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Đóa hoa đồng thoại - minh họa trang sách</div></a>
        <a href="/en/tarot" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/tarot/thumb.webp" alt="Tarot" width="900" height="900" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Tarot</div></a>
      </section>

      <div class="h-[100px]" aria-hidden="true"></div>
    </div>
  
</BaseLayout>
