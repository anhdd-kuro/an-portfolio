---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "UI/UX Design | Thuy An Portfolio";

const description = "UI/UX design portfolio of Thuy An – web, landing page and app UI projects.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="en" page="ui-design" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-12 dt:px-20 pt-8 mb:pt-[46px]">
      <h1 class="sr-only">UI/UX Design</h1>
      <section class="flex flex-col items-center mb:flex-row mb:flex-wrap gap-8 mb:gap-[78px] mb:items-center" aria-label="Introduction">
        <img src="/assets/images/uidesign.png" alt="UI design" class="block h-[175px] mb:h-[317px] w-auto max-w-full object-contain shrink-0" width="949" height="793">
        <p class="text-body text-left mb:text-justify max-w-[550px] min-w-0 mb:flex-1 mb:basis-[360px] text-pretty">I have approximately 3 years of experience in UI design, including the opportunity to work with TikTok, small-scale brands, and within a Japanese company. My experience involves direct client interaction and collaboration with cross-functional teams.</p>
      </section>
      <section class="mt-16 grid grid-cols-1 justify-items-center mb:grid-cols-[repeat(auto-fit,300px)] mb:justify-items-stretch justify-center gap-y-[60px] gap-x-[50px]" aria-label="UI/UX projects">
        <h2 class="sr-only">Projects</h2>
        <a href="/en/tiktok-camp" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/tiktok-camp/thumb.webp" alt="Tiktok camp - UI design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Tiktok camp - UI design</div></a>
        <a href="/en/top-member-page" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/top-member-page/thumb.webp" alt="Top member page - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Top member page - LP design</div></a>
        <a href="/en/offshore" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/offshore/thumb.webp" alt="Offshore - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Offshore - LP design</div></a>
        <a href="/en/lucky-money" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/lucky-money/thumb.webp" alt="Lucky money - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Lucky money - LP design</div></a>
        <a href="/en/trust-group" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/trust-group/thumb.webp" alt="Trust group - HP design (demo)" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Trust group - HP design (demo)</div></a>
        <a href="/en/matching-app" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/matching-app/thumb.webp" alt="Matching app - App mobile design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Matching app - App mobile design</div></a>
        <a href="/en/kagu-page" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/kagu-page/thumb.webp" alt="Kagu page - EC design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Kagu page - EC design</div></a>
        <a href="/en/bento-recipe" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/bento-recipe/thumb.webp" alt="Bento recipe - LP | App design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Bento recipe - LP | App design</div></a>
        <a href="/en/game-find-me" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/game-find-me/thumb.webp" alt="Game find me" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Game find me</div></a>
        <a href="/en/game-jump" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/game-jump/thumb.webp" alt="Game jump" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Game jump</div></a>
        <a href="/en/yoseka" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/yoseka/thumb.webp" alt="Yoseka themme design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Yoseka themme design</div></a>
        <a href="/en/ketnoi" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/ketnoi/thumb.webp" alt="Ketnoi - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Ketnoi - LP design</div></a>
        <a href="/en/waveland" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/waveland/thumb.webp" alt="Waveland - LP design" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Waveland - LP design</div></a>
        <a href="/en/qwiq-logo" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/qwiq-logo/thumb.webp" alt="Qwiq logo" width="900" height="900" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Qwiq logo</div></a>
      </section>
      <div class="h-[100px]" aria-hidden="true"></div>
    </div>
  
</BaseLayout>
