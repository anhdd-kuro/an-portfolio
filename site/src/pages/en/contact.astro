---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Contact | Thuy An Portfolio";
const description = "Get in touch with Thuy An – illustrator and UI designer. Email and social links.";
const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="en" page="contact" title={title} description={description} ogImage={ogImage} divider={true}>

    <section class="px-6 mb:px-16 dt:px-[140px] pt-8 mb:pt-[46px] flex flex-col items-center">
      <h1 class="sr-only">Contact</h1>
      <img src="/assets/images/contact.png" alt="Contact" class="block h-[178px] mb:h-[324px] w-auto max-w-full object-contain" width="895" height="837">
      <p class="mt-12 max-w-[880px] text-center mb:text-left font-normal text-[16px] leading-5 text-pretty">Hi, I’m Thuy An, an illustrator and UI designer who loves drawing, designing, and turning ideas into things people can enjoy. I’m always curious, always making, and always looking for a new story to tell.<br><br><strong>Let’s make something good together. Have an idea? I’d love to hear from you!<br>Email : <a href="mailto:nguyenan19495@gmail.com" class="underline">nguyenan19495@gmail.com</a></strong></p>
      <div class="mt-7 flex gap-8">
        <a href="https://www.facebook.com/vuive194/" target="_blank" rel="noopener" class="img-btn block w-[47px] h-12" style="background-image:url(/assets/icons/fb.png)" aria-label="Facebook"></a>
        <a href="https://www.instagram.com/thuyan.illustration/" target="_blank" rel="noopener" class="img-btn block w-[47px] h-12" style="background-image:url(/assets/icons/instagram.png)" aria-label="Instagram"></a>
      </div>
      <div class="h-[100px] mb:h-[158px]" aria-hidden="true"></div>
    </section>
  
</BaseLayout>
