---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Thuy An | Illustrator & UI Designer";

const description = "Portfolio of Thuy An – illustrator and UI/UX designer based in Fukuoka, Japan.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="en" page="home" title={title} description={description} ogImage={ogImage} divider={false}>

    <h1 class="sr-only">Thuy An – Illustrator &amp; UI Designer</h1>

    <!-- ===== HERO BANNER ===== -->
    <section aria-label="Bookshelf – pick a book to explore">
      <!-- Tablet / desktop banner -->
      <div class="hidden mb:block relative w-full bg-white">
        <img src="/assets/images/banner.webp" alt="Hand-drawn bookshelf – pick a book to explore" class="block w-full h-auto" width="1920" height="1467" fetchpriority="high">
        <a href="/en/about" class="hot" style="left:68.6719%;top:1.5337%;width:20.3906%" aria-label="About me" title="About me">
          <img class="hot-still" src="/assets/images/still-about-pc.png" alt="" width="261" height="169" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-about-pc.gif" data-gif="/assets/images/hover-about-pc.gif" alt="" width="261" height="169" loading="lazy" decoding="async">
        </a>
        <a href="/en/ui-design" class="hot" style="left:47.8125%;top:15.4397%;width:16.0156%" aria-label="UI design" title="UI design">
          <img class="hot-still" src="/assets/images/still-uidesign-pc.png" alt="" width="205" height="187" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-uidesign-pc.gif" data-gif="/assets/images/hover-uidesign-pc.gif" alt="" width="205" height="187" loading="lazy" decoding="async">
        </a>
        <a href="/en/illustration" class="hot" style="left:32.6562%;top:31.6973%;width:25.2344%" aria-label="Illustration" title="Illustration">
          <img class="hot-still" src="/assets/images/still-illustration-pc.png" alt="" width="323" height="165" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-illustration-pc.gif" data-gif="/assets/images/hover-illustration-pc.gif" alt="" width="323" height="165" loading="lazy" decoding="async">
        </a>
        <a href="/en/contact" class="hot" style="left:7.5%;top:47.955%;width:17.9688%" aria-label="Contact" title="Contact">
          <img class="hot-still" src="/assets/images/still-contact-pc.png" alt="" width="230" height="164" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-contact-pc.gif" data-gif="/assets/images/hover-contact-pc.gif" alt="" width="230" height="164" loading="lazy" decoding="async">
        </a>
      </div>
      <!-- Mobile banner -->
      <div class="mb:hidden relative w-full bg-white">
        <img src="/assets/images/banner-mobile.webp" alt="Hand-drawn bookshelf – pick a book to explore" class="block w-full h-auto" width="750" height="1548" fetchpriority="high">
        <a href="/en/about" class="hot" style="left:29.8667%;top:10.9819%;width:37.8667%" aria-label="About me" title="About me">
          <img class="hot-still" src="/assets/images/still-about-sp.png" alt="" width="284" height="181" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-about-sp.gif" data-gif="/assets/images/hover-about-sp.gif" alt="" width="284" height="181" loading="lazy" decoding="async">
        </a>
        <a href="/en/ui-design" class="hot" style="left:49.3333%;top:28.876%;width:27.4667%" aria-label="UI design" title="UI design">
          <img class="hot-still" src="/assets/images/still-uidesign-sp.png" alt="" width="206" height="188" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-uidesign-sp.gif" data-gif="/assets/images/hover-uidesign-sp.gif" alt="" width="206" height="188" loading="lazy" decoding="async">
        </a>
        <a href="/en/illustration" class="hot" style="left:6.9333%;top:46.9638%;width:46.6667%" aria-label="Illustration" title="Illustration">
          <img class="hot-still" src="/assets/images/still-illustration-sp.png" alt="" width="350" height="177" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-illustration-sp.gif" data-gif="/assets/images/hover-illustration-sp.gif" alt="" width="350" height="177" loading="lazy" decoding="async">
        </a>
        <a href="/en/contact" class="hot" style="left:3.0667%;top:65.6331%;width:33.2%" aria-label="Contact" title="Contact">
          <img class="hot-still" src="/assets/images/still-contact-sp.png" alt="" width="249" height="177" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-contact-sp.gif" data-gif="/assets/images/hover-contact-sp.gif" alt="" width="249" height="177" loading="lazy" decoding="async">
        </a>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section aria-labelledby="about-h" class="flex flex-col items-center pt-[136px] px-6 mb:flex-row mb:flex-wrap mb:gap-10 mb:px-12 mb:pt-[160px] mb:items-start dt:gap-[79px] dt:px-[84px] dt:pt-[196px]">
      <h2 id="about-h" class="sr-only">About me</h2>
      <img src="/assets/images/aboutme.png" alt="About me" class="w-[200px] max-w-full h-auto object-contain mb:w-[280px] mb:h-[300px] mb:shrink-0 dt:w-[383px] dt:h-[400px]" loading="lazy">
      <div class="w-full mb:w-auto mb:max-w-[650px] mb:flex-1 mb:basis-[300px] mb:min-w-0 mb:pt-10 dt:basis-[380px] dt:pt-[84px]">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:mt-0">I’m Thuy An. I work as an illustrator and UI designer, currently living in Fukuoka, Japan.<br><br>I’ve been drawing and designing for quite a few years now. I used to focus mainly on illustration and book cover work, and later started doing UI design as well. I love drawing, collecting picture books, coffee, cats, and wandering around bookstores looking for ideas — turning an idea in my head into an actual image is something that always makes me happy.<br><br>If that sounds like you too, I’d love to meet you!</p>
        <a href="/en/about" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8" style="background-image:url(/assets/images/readmore.png)" aria-label="Read more" title="Read more"></a>
      </div>
    </section>

    <!-- ===== ILLUSTRATION ===== -->
    <section aria-labelledby="illus-h" class="flex flex-col items-center pt-[152px] px-6 mb:flex-row-reverse mb:flex-wrap mb:gap-14 mb:px-[60px] mb:pt-[168px] mb:justify-center mb:items-start dt:grid dt:grid-cols-2">
      <h2 id="illus-h" class="sr-only">Illustration</h2>
      <div class="flex flex-col items-center w-full mb:w-[492px] mb:max-w-full dt:w-full dt:max-w-[492px] dt:justify-self-end">
        <img src="/assets/images/illus.png" alt="Illustration" class="w-[220px] max-w-full h-auto object-contain mb:w-full mb:h-[400px]" loading="lazy">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:text-justify mb:mt-10">I have around 8 years of experience in illustration, including the opportunity to work with publishers in Vietnam. I have also independently published my own book. I would be extremely grateful if everyone enjoys it!</p>
        <a href="/en/illustration" class="img-btn block w-[138px] h-[64px] mx-auto mt-8 hidden dt:block" style="background-image:url(/assets/images/readmore.png)" aria-label="Read more" title="Read more"></a>
      </div>
      <div class="w-full max-w-[320px] mt-10 mb:w-[632px] mb:max-w-full mb:mt-0 dt:w-full dt:order-first">
        <div class="grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8">
          <a href="/en/artwork" class="block group"><img src="/assets/images/work/70338b4f401c.webp" alt="My artwork" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">My artwork</div></a>
          <a href="/en/watermelon-seed" class="block group"><img src="/assets/images/work/4aa20ea3d416.webp" alt="Accidentally swallowed the watermelon seed" width="1177" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Accidentally swallowed the watermelon seed</div></a>
          <a href="/en/lights-adventure" class="block group"><img src="/assets/images/work/e003c4d3bcb7.webp" alt="Light's Adventure" width="1200" height="1066" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Light's Adventure</div></a>
          <a href="/en/happy-flight" class="block group"><img src="/assets/images/work/95b49d0f1af8.webp" alt="Happy flight" width="786" height="974" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Happy flight</div></a>
        </div>
        <a href="/en/illustration" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8 dt:hidden" style="background-image:url(/assets/images/readmore.png)" aria-label="Read more" title="Read more"></a>
      </div>
    </section>

    <!-- ===== UI DESIGN ===== -->
    <section aria-labelledby="ui-h" class="flex flex-col items-center pt-[176px] px-6 mb:flex-row-reverse mb:flex-wrap mb:gap-14 mb:px-[60px] mb:pt-[200px] mb:justify-center mb:items-start dt:grid dt:grid-cols-2">
      <h2 id="ui-h" class="sr-only">UI design</h2>
      <div class="flex flex-col items-center w-full mb:w-[479px] mb:max-w-full dt:w-full dt:max-w-[479px] dt:justify-self-start">
        <img src="/assets/images/uidesign.png" alt="UI design" class="w-[220px] max-w-full h-auto object-contain mb:w-full mb:h-[400px]" loading="lazy">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:text-justify mb:mt-10">I have approximately 3 years of experience in UI design, including the opportunity to work with TikTok, small-scale brands, and within a Japanese company. My experience involves direct client interaction and collaboration with cross-functional teams.</p>
        <a href="/en/ui-design" class="img-btn block w-[138px] h-[64px] mx-auto mt-8 hidden dt:block" style="background-image:url(/assets/images/readmore.png)" aria-label="Read more" title="Read more"></a>
      </div>
      <div class="w-full max-w-[320px] mt-10 mb:w-[632px] mb:max-w-full mb:mt-0 dt:w-full">
        <div class="grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8">
          <a href="/en/tiktok-camp" class="block group"><img src="/assets/images/projects/tiktok-camp/thumb.webp" alt="Tiktok camp - UI design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Tiktok camp - UI design</div></a>
          <a href="/en/top-member-page" class="block group"><img src="/assets/images/projects/top-member-page/thumb.webp" alt="Top member page - LP design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Top member page - LP design</div></a>
          <a href="/en/offshore" class="block group"><img src="/assets/images/projects/offshore/thumb.webp" alt="Offshore - LP design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Offshore - LP design</div></a>
          <a href="/en/lucky-money" class="block group"><img src="/assets/images/projects/lucky-money/thumb.webp" alt="Lucky money - LP design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Lucky money - LP design</div></a>
        </div>
        <a href="/en/ui-design" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8 dt:hidden" style="background-image:url(/assets/images/readmore.png)" aria-label="Read more" title="Read more"></a>
      </div>
    </section>

    <!-- ===== CONTACT TEASER ===== -->
    <section aria-labelledby="contact-h" class="pt-[200px] flex flex-col items-center">
      <h2 id="contact-h" class="sr-only">Contact</h2>
      <img src="/assets/images/contact.png" alt="Contact" class="w-[280px] max-w-[60%] mb:w-[340px] mb:max-w-full dt:w-[387px] h-auto object-contain" loading="lazy">
      <p class="mt-12 max-w-[880px] px-6 text-center font-normal text-[16px] leading-6 text-pretty">Hi, I’m Thuy An, an illustrator and UI designer who loves drawing, designing, and turning ideas into things people can enjoy. I’m always curious, always making, and always looking for a new story to tell.<br><br><strong>Let’s make something good together. Have an idea? I’d love to hear from you!<br>Email : <a href="mailto:nguyenan19495@gmail.com" class="underline">nguyenan19495@gmail.com</a></strong></p>
      <div class="h-[79px]" aria-hidden="true"></div>
    </section>
  
</BaseLayout>
