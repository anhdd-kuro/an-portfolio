---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "About me | Thuy An Portfolio";
const description = "About Thuy An – illustrator and UI designer from Vietnam based in Fukuoka: employment overview, work experience and design skills.";
const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="en" page="about" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-16 dt:px-[140px] pt-10 mb:pt-[66px]">
      <h1 class="sr-only">About me</h1>
      <img src="/assets/images/aboutme.png" alt="About me – hand-drawn portrait" class="block h-[189px] mb:h-[343px] w-auto max-w-full object-contain mx-auto" width="848" height="886">
      <div class="mt-[52px] flex flex-col gap-7">
      <section>
        <h2 class="font-extrabold text-[18px] mb-2">[Employment Overview]</h2>
        <p class="text-[16px] leading-[22px] font-normal text-pretty">・While still a university student, I worked as an intern on 2D graphic design such as flyers and posters.<br>・I designed and sold products of my own, including New Year money envelopes and postcards.<br>・As a freelancer I took commissions from various publishers in Vietnam, working both digitally and by hand.<br>・On a commission from a Chinese manga publisher, I set up a studio with friends as a startup and handled manga colouring.<br>・At CaeruxLab I work as an illustrator and on UI/UX design.</p>
      </section>
      <section>
        <h2 class="font-extrabold text-[18px] mb-2">[Work Experience]</h2>
        <p class="text-[16px] leading-[22px] font-normal text-pretty">・Until June 2018<br>Intern at a design company in Vietnam<br>Client: a Vietnamese company<br>Work: 2D graphic design such as flyers and posters<br>Team size: on my own<br>Software: Photoshop, Illustrator<br><br>・October 2018 - April 2019<br>A startup founded with friends on a commission from a Chinese company<br>Client: a Chinese manga company<br>Work: from the name (storyboard) through inked pages and colouring to the finished artwork<br>Team size: 6<br>As the leader I assigned the tasks, managed quality and drew as well<br>Software: Photoshop, Illustrator<br><br>・April 2019 - March 2022<br>Freelancing remotely while attending a Japanese language school<br>Client: publishers in Vietnam<br>Work: turning manuscripts into picture books<br>Team size: on my own<br>Software: Photoshop, Illustrator<br><br>・March 2022 - December 2024<br>Designer at CaeruxLab<br>Work: UI/UX design and mini-game design<br>Software: Photoshop, Illustrator, Adobe XD, Figma<br><br>・January 2025 - present<br>Working as a designer under a contract with Caerux Inc. (head office)<br>Work: UI/UX design and illustration<br>Software: Photoshop, Illustrator, Adobe XD, Figma</p>
      </section>
      <section>
        <h2 class="font-extrabold text-[18px] mb-2">[Designer Skills]</h2>
        <p class="text-[16px] leading-[22px] font-normal text-pretty">・Photoshop (hands-on experience: about 8 years)<br>・Illustrator (hands-on experience: about 8 years)<br>・Adobe XD (hands-on experience: about 3 years)<br>・Figma (hands-on experience: about 2 years)<br>・Hand drawing</p>
      </section>
      </div>
    </div>
    <div class="h-[100px] mb:h-[173px]" aria-hidden="true"></div>
  
</BaseLayout>
