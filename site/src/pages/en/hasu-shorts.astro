---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Hasu wearing shorts | Thuy An Portfolio";
const description = "This ehon book is part of a series of 4 books that revolve around the boy named Hasu and his adventures. The content of this book was edited by Trang ";
const ogImage = "/assets/images/work/49037c276be7.webp";
---
<BaseLayout lang="en" page="hasu-shorts" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/49037c276be7.webp" alt="Cover" width="2400" height="1048" class="block w-full h-auto" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Hasu wearing shorts - 2019</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">Illustration : Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">This ehon book is part of a series of 4 books that revolve around the boy named Hasu and his adventures. The content of this book was edited by Trang Kyu, and I was responsible for the illustrations.</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/90ec66e69a0c.webp" alt="Artwork 1" width="1184" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/cacc48fddb1e.webp" alt="Artwork 2" width="1200" height="1184" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/ac70db6c0296.webp" alt="Artwork 3" width="1200" height="1184" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/66233ef8b718.webp" alt="Artwork 4" width="1200" height="1196" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/077a12457fc7.webp" alt="Artwork 5" width="1130" height="1130" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/0d15ee9cd08f.webp" alt="Artwork 6" width="1134" height="1142" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/aff1839dd9b6.webp" alt="Artwork 7" width="1194" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/68924110f00e.webp" alt="Artwork 8" width="1126" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/38f642692e0a.webp" alt="Artwork 9" width="1102" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/bc5155e82080.webp" alt="Artwork 10" width="1120" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/582498dc15d8.webp" alt="Artwork 11" width="1200" height="918" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">
        <img src="/assets/images/work/b251388c4647.webp" alt="Closing illustration" width="1200" height="1124" class="block w-[200px] h-[200px] mb:w-[250px] mb:h-[250px] rounded-full object-cover object-center mx-auto" loading="lazy" decoding="async">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
  
</BaseLayout>
