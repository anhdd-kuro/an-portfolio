---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Happy flight | Thuy An Portfolio";

const description = "The ehon “Happy Flight” is the winner of the special prize at the 6th Doa hoa dong thoai Awards and has been adapted into an ehon by Doa hoa dong thoa";

const ogImage = "/assets/images/work/ef3a16f3008e.webp";
---
<BaseLayout lang="en" page="happy-flight" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/ef3a16f3008e.webp" alt="Cover" width="2400" height="1483" class="block w-full h-auto" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Chuyen bay hanh phuc - 2024</h1>
        <p class="mt-1 font-extrabold text-[18px] mb:text-2xl leading-8 font-jp">Happy flight</p>
        <p class="mt-3 text-[18px] leading-6 font-medium">Illustration : Thuy An - Content : Dao Khuong Duy</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">The ehon “Happy Flight” is the winner of the special prize at the 6th Doa hoa dong thoai Awards and has been adapted into an ehon by Doa hoa dong thoai - Quy Bac Cau. The ehon was launched at a press conference at the beginning of March 2024 at the Vietnam Literature Museum.</p>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words"><a href="https://doahoadongthoai.com/" target="_blank" rel="noopener" class="underline decoration-1 underline-offset-2">Information about the book can be found here.</a></p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="w-full mx-auto max-w-[393px]"><img src="/assets/images/work/95b49d0f1af8.webp" alt="Artwork 1" width="786" height="974" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[450px]"><img src="/assets/images/work/8e652c6de578.webp" alt="Artwork 2" width="900" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[786px]"><img src="/assets/images/work/53c839868ba5.webp" alt="Artwork 3" width="1572" height="972" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[788px]"><img src="/assets/images/work/3bc761459d75.webp" alt="Artwork 4" width="1577" height="973" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[414px]"><img src="/assets/images/work/9887eb947450.webp" alt="Artwork 5" width="828" height="763" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[392px]"><img src="/assets/images/work/b8c68fa457ad.webp" alt="Artwork 6" width="784" height="972" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/8e4f6cfd88d4.webp" alt="Artwork 7" width="2200" height="1467" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/47d81fd60518.webp" alt="Artwork 8" width="2200" height="1467" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/6300c0565292.webp" alt="Artwork 9" width="2200" height="1467" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/e7adba44b763.webp" alt="Artwork 10" width="2200" height="1467" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/23497e7e643d.webp" alt="Artwork 11" width="2200" height="1467" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">
        <img src="/assets/images/work/8a57446f6269.webp" alt="Closing illustration" width="298" height="299" class="block w-[200px] h-[200px] mb:w-[250px] mb:h-[250px] rounded-full object-cover object-center mx-auto" loading="lazy" decoding="async">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
  
</BaseLayout>
