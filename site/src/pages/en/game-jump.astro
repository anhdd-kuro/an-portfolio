---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Game jump | Thuy An Portfolio";
const description = "This is a project that I worked on while at Caeruxlab company.";
const ogImage = "/assets/images/projects/game-jump/cover.webp";
---
<BaseLayout lang="en" page="game-jump" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Game jump</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">This is a project that I worked on while at Caeruxlab company.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Category : Mobile game UI design<br>Client : Caeruxlab<br>Tool used : Adobe XD, Adobe illustrator</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">Artwork</h2>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 dt:grid-cols-3 gap-8 mb:gap-10 justify-items-center items-start">
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/01.webp" alt="Screen 1" width="800" height="1425" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/02.webp" alt="Screen 2" width="800" height="1430" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/03.webp" alt="Screen 3" width="800" height="1431" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/04.webp" alt="Screen 4" width="800" height="1422" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/05.webp" alt="Screen 5" width="800" height="1433" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/06.webp" alt="Screen 6" width="800" height="1426" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/07.webp" alt="Screen 7" width="800" height="1735" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/08.webp" alt="Screen 8" width="800" height="1717" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/09.webp" alt="Screen 9" width="800" height="1740" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
          <div class="w-full mx-auto" style="max-width:320px"><img src="/assets/images/projects/game-jump/10.webp" alt="Screen 10" width="800" height="1743" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">

        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/ui-design" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
  
</BaseLayout>
