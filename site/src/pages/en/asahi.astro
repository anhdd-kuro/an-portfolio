---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Asahi | Thuy An Portfolio";

const description = "This is a project that I worked on while at Caeruxlab company.";

const ogImage = "/assets/images/work/a9ef1987abe2.webp";
---
<BaseLayout lang="en" page="asahi" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/a9ef1987abe2.webp" alt="Cover" width="2560" height="1026" class="block w-full h-auto" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Asahi</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">This is a project that I worked on while at Caeruxlab company.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Category : Illustration &amp; character design<br>Client : Caerux<br>Tool used : Adobe XD, Adobe illustrator</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="dt:col-span-2 mx-auto w-full max-w-[700px]"><img src="/assets/images/work/6fd199499632.webp" alt="Artwork 1" width="1400" height="1224" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/c7924a5998e9.webp" alt="Artwork 2" width="2000" height="1580" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[700px]"><img src="/assets/images/work/f76eadd7da2e.webp" alt="Artwork 3" width="1400" height="1224" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/2f85f5ba0c6a.webp" alt="Artwork 4" width="2000" height="1534" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/c04441ba686e.webp" alt="Artwork 5" width="2000" height="1463" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">

        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
  
</BaseLayout>
