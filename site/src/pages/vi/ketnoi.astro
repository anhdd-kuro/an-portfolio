---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Ketnoi - LP design | Thuy An Portfolio";
const description = "This is a project that I worked on while at Caeruxlab company.";
const ogImage = "/assets/images/projects/ketnoi/thumb.webp";
---
<BaseLayout lang="vi" page="ketnoi" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Ketnoi - LP design</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">Đây là dự án mình thực hiện trong thời gian làm việc tại công ty Caeruxlab.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Hạng mục : Thiết kế Homepage<br>Khách hàng : Caeruxlab<br>Công cụ : Adobe XD, Figma</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="grid grid-cols-1 gap-10 mb:gap-[50px] items-start">
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/ketnoi/s01.webp" alt="Screen 1" width="3222" height="2379" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/ketnoi/s02.webp" alt="Screen 2" width="3222" height="2379" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/ketnoi/s03.webp" alt="Screen 3" width="3222" height="2373" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/ketnoi/s04.webp" alt="Screen 4" width="3222" height="2373" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/ui-design" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>

</BaseLayout>
