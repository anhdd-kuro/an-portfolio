---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Minh hoạ | Thuy An Portfolio";

const description = "Illustration portfolio of Thuy An – picture books, book covers and hand-drawn artwork.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="vi" page="illustration" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="px-6 mb:px-12 dt:px-20 pt-8 mb:pt-[46px]">
      <h1 class="sr-only">Illustration</h1>
      <section class="flex flex-col items-center mb:flex-row mb:flex-wrap gap-8 mb:gap-[78px] mb:items-center" aria-label="Introduction">
        <img src="/assets/images/illus.png" alt="Illustration" class="block h-[173px] mb:h-[315px] w-auto max-w-full object-contain shrink-0" width="1067" height="867">
        <p class="text-body text-left mb:text-justify max-w-[550px] min-w-0 mb:flex-1 mb:basis-[360px] text-pretty">Mình có khoảng 8 năm kinh nghiệm vẽ minh hoạ, trong đó có cơ hội hợp tác với nhiều nhà xuất bản tại Việt Nam. Mình cũng đã tự xuất bản cuốn sách riêng của mình. Mình sẽ rất vui nếu mọi người thích nó!</p>
      </section>

      <section class="mt-16 grid grid-cols-1 justify-items-center mb:grid-cols-[repeat(auto-fit,300px)] mb:justify-items-stretch justify-center gap-y-[60px] gap-x-[50px]" aria-label="Illustration projects">
        <h2 class="sr-only">Projects</h2>
        <a href="/vi/artwork" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/70338b4f401c.webp" alt="My artwork" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">My artwork</div></a>
        <a href="/vi/watermelon-seed" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/4aa20ea3d416.webp" alt="Lỡ nuốt phải hạt dưa mất rồi" width="1177" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Lỡ nuốt phải hạt dưa mất rồi</div></a>
        <a href="/vi/lights-adventure" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/e003c4d3bcb7.webp" alt="Chuyến phiêu lưu của ánh nắng" width="1200" height="1066" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Chuyến phiêu lưu của ánh nắng</div></a>
        <a href="/vi/happy-flight" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/95b49d0f1af8.webp" alt="Chuyến bay hạnh phúc" width="786" height="974" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Chuyến bay hạnh phúc</div></a>
        <a href="/vi/hasu-shorts" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/11aef93cb9b1.webp" alt="Hasu đầu quần" width="1184" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu đầu quần</div></a>
        <a href="/vi/hasu-gardening" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/dbcd3708f4f3.webp" alt="Hasu làm vườn" width="1184" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu làm vườn</div></a>
        <a href="/vi/hasu-camping" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/f6f19e2e7c3a.webp" alt="Hasu đi cắm trại" width="1166" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu đi cắm trại</div></a>
        <a href="/vi/hasu-guessing-game" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/04cb46a26902.webp" alt="Hasu chơi đoán hình" width="1197" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Hasu chơi đoán hình</div></a>
        <a href="/vi/book-cover-design" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/d952af45a500.webp" alt="Thiết kế bìa sách" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Thiết kế bìa sách</div></a>
        <a href="/vi/asahi" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/asahi-thumb.webp" alt="Dự án Asahi" width="1400" height="1224" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Dự án Asahi</div></a>
        <a href="/vi/kaeru-sticker" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/work/1a7133ed05e9.webp" alt="Thiết kế minh họa sticker Kaeru" width="998" height="964" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Thiết kế minh họa sticker Kaeru</div></a>
        <a href="/vi/doa-hoa-dong-thoai" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/doa-hoa-dong-thoai/thumb.webp" alt="Đóa hoa đồng thoại - minh họa trang truyện" width="900" height="900" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Đóa hoa đồng thoại - minh họa trang truyện</div></a>
        <a href="/vi/tarot" class="block group w-full max-w-[300px] mb:w-[300px]"><img src="/assets/images/projects/tarot/thumb.webp" alt="Minh họa tarot" width="900" height="900" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Minh họa tarot</div></a>
      </section>

      <div class="h-[100px]" aria-hidden="true"></div>
    </div>
  
</BaseLayout>
