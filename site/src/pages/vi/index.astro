---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Thuy An | Illustrator & UI Designer";

const description = "Portfolio of Thuy An – illustrator and UI/UX designer based in Fukuoka, Japan.";

const ogImage = "/assets/images/logo.png";
---
<BaseLayout lang="vi" page="home" title={title} description={description} ogImage={ogImage} divider={false}>

    <h1 class="sr-only">Thuy An – Illustrator &amp; UI Designer</h1>

    <!-- ===== HERO BANNER ===== -->
    <section aria-label="Bookshelf – pick a book to explore">
      <!-- Tablet / desktop banner -->
      <div class="hidden mb:block relative w-full bg-white">
        <img src="/assets/images/banner.webp" alt="Hand-drawn bookshelf – pick a book to explore" class="block w-full h-auto" width="1920" height="1467" fetchpriority="high">
        <a href="/vi/about" class="hot" style="left:68.6719%;top:1.5337%;width:20.3906%" aria-label="Về tôi" title="Về tôi">
          <img class="hot-still" src="/assets/images/still-about-pc.png" alt="" width="261" height="169" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-about-pc.gif" data-gif="/assets/images/hover-about-pc.gif" alt="" width="261" height="169" loading="lazy" decoding="async">
        </a>
        <a href="/vi/ui-design" class="hot" style="left:47.8125%;top:15.4397%;width:16.0156%" aria-label="Thiết kế UI" title="Thiết kế UI">
          <img class="hot-still" src="/assets/images/still-uidesign-pc.png" alt="" width="205" height="187" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-uidesign-pc.gif" data-gif="/assets/images/hover-uidesign-pc.gif" alt="" width="205" height="187" loading="lazy" decoding="async">
        </a>
        <a href="/vi/illustration" class="hot" style="left:32.6562%;top:31.6973%;width:25.2344%" aria-label="Minh hoạ" title="Minh hoạ">
          <img class="hot-still" src="/assets/images/still-illustration-pc.png" alt="" width="323" height="165" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-illustration-pc.gif" data-gif="/assets/images/hover-illustration-pc.gif" alt="" width="323" height="165" loading="lazy" decoding="async">
        </a>
        <a href="/vi/contact" class="hot" style="left:7.5%;top:47.955%;width:17.9688%" aria-label="Liên hệ" title="Liên hệ">
          <img class="hot-still" src="/assets/images/still-contact-pc.png" alt="" width="230" height="164" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-contact-pc.gif" data-gif="/assets/images/hover-contact-pc.gif" alt="" width="230" height="164" loading="lazy" decoding="async">
        </a>
      </div>
      <!-- Mobile banner -->
      <div class="mb:hidden relative w-full bg-white">
        <img src="/assets/images/banner-mobile.webp" alt="Hand-drawn bookshelf – pick a book to explore" class="block w-full h-auto" width="750" height="1548" fetchpriority="high">
        <a href="/vi/about" class="hot" style="left:29.8667%;top:10.9819%;width:37.8667%" aria-label="Về tôi" title="Về tôi">
          <img class="hot-still" src="/assets/images/still-about-sp.png" alt="" width="284" height="181" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-about-sp.gif" data-gif="/assets/images/hover-about-sp.gif" alt="" width="284" height="181" loading="lazy" decoding="async">
        </a>
        <a href="/vi/ui-design" class="hot" style="left:49.3333%;top:28.876%;width:27.4667%" aria-label="Thiết kế UI" title="Thiết kế UI">
          <img class="hot-still" src="/assets/images/still-uidesign-sp.png" alt="" width="206" height="188" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-uidesign-sp.gif" data-gif="/assets/images/hover-uidesign-sp.gif" alt="" width="206" height="188" loading="lazy" decoding="async">
        </a>
        <a href="/vi/illustration" class="hot" style="left:6.9333%;top:46.9638%;width:46.6667%" aria-label="Minh hoạ" title="Minh hoạ">
          <img class="hot-still" src="/assets/images/still-illustration-sp.png" alt="" width="350" height="177" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-illustration-sp.gif" data-gif="/assets/images/hover-illustration-sp.gif" alt="" width="350" height="177" loading="lazy" decoding="async">
        </a>
        <a href="/vi/contact" class="hot" style="left:3.0667%;top:65.6331%;width:33.2%" aria-label="Liên hệ" title="Liên hệ">
          <img class="hot-still" src="/assets/images/still-contact-sp.png" alt="" width="249" height="177" decoding="async">
          <img class="hot-anim" src="/assets/images/hover-contact-sp.gif" data-gif="/assets/images/hover-contact-sp.gif" alt="" width="249" height="177" loading="lazy" decoding="async">
        </a>
      </div>
    </section>

    <!-- ===== ABOUT ===== -->
    <section aria-labelledby="about-h" class="flex flex-col items-center pt-[136px] px-6 mb:flex-row mb:flex-wrap mb:gap-10 mb:px-12 mb:pt-[160px] mb:items-start dt:gap-[79px] dt:px-[84px] dt:pt-[196px]">
      <h2 id="about-h" class="sr-only">About me</h2>
      <img src="/assets/images/aboutme.png" alt="About me" class="w-[200px] max-w-full h-auto object-contain mb:w-[280px] mb:h-[300px] mb:shrink-0 dt:w-[383px] dt:h-[400px]" loading="lazy">
      <div class="w-full mb:w-auto mb:max-w-[650px] mb:flex-1 mb:basis-[300px] mb:min-w-0 mb:pt-10 dt:basis-[380px] dt:pt-[84px]">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:mt-0">Mình là Thúy An. Mình làm illustrator và UI designer, hiện đang sống ở Fukuoka, Nhật Bản.<br><br>Mình đã làm công việc vẽ và thiết kế được khá nhiều năm rồi. Trước đây mình chủ yếu nhận vẽ minh hoạ và bìa sách, sau này mình bắt đầu làm thêm UI design. Mình thích vẽ, thích sưu tầm sách tranh, thích cafe, thích mèo, thích lang thang trong hiệu sách tìm ý tưởng và biến một ý tưởng trong đầu thành hình ảnh luôn là điều mình thấy rất vui.<br><br>Nếu bạn cũng thế, thì rất vui được gặp bạn!</p>
        <a href="/vi/about" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8" style="background-image:url(/assets/images/readmore.png)" aria-label="Xem thêm" title="Xem thêm"></a>
      </div>
    </section>

    <!-- ===== ILLUSTRATION ===== -->
    <section aria-labelledby="illus-h" class="flex flex-col items-center pt-[152px] px-6 mb:flex-row-reverse mb:flex-wrap mb:gap-14 mb:px-[60px] mb:pt-[168px] mb:justify-center mb:items-start dt:grid dt:grid-cols-2">
      <h2 id="illus-h" class="sr-only">Illustration</h2>
      <div class="flex flex-col items-center w-full mb:w-[492px] mb:max-w-full dt:w-full dt:max-w-[492px] dt:justify-self-end">
        <img src="/assets/images/illus.png" alt="Illustration" class="w-[220px] max-w-full h-auto object-contain mb:w-full mb:h-[400px]" loading="lazy">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:text-justify mb:mt-10">Mình có khoảng 8 năm kinh nghiệm vẽ minh hoạ, trong đó có cơ hội hợp tác với nhiều nhà xuất bản tại Việt Nam. Mình cũng đã tự xuất bản cuốn sách riêng của mình. Mình sẽ rất vui nếu mọi người thích nó!</p>
        <a href="/vi/illustration" class="img-btn block w-[138px] h-[64px] mx-auto mt-8 hidden dt:block" style="background-image:url(/assets/images/readmore.png)" aria-label="Xem thêm" title="Xem thêm"></a>
      </div>
      <div class="w-full max-w-[320px] mt-10 mb:w-[632px] mb:max-w-full mb:mt-0 dt:w-full dt:order-first">
        <div class="grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8">
          <a href="/vi/artwork" class="block group"><img src="/assets/images/work/70338b4f401c.webp" alt="Tranh cá nhân" width="1200" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Tranh cá nhân</div></a>
          <a href="/vi/watermelon-seed" class="block group"><img src="/assets/images/work/4aa20ea3d416.webp" alt="Lỡ nuốt phải hạt dưa hấu" width="1177" height="1200" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Lỡ nuốt phải hạt dưa hấu</div></a>
          <a href="/vi/lights-adventure" class="block group"><img src="/assets/images/work/e003c4d3bcb7.webp" alt="Chuyện phiêu lưu của ánh nắng" width="1200" height="1066" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Chuyện phiêu lưu của ánh nắng</div></a>
          <a href="/vi/happy-flight" class="block group"><img src="/assets/images/work/95b49d0f1af8.webp" alt="Chuyến bay hạnh phúc" width="786" height="974" class="block w-full aspect-square object-cover object-center rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Chuyến bay hạnh phúc</div></a>
        </div>
        <a href="/vi/illustration" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8 dt:hidden" style="background-image:url(/assets/images/readmore.png)" aria-label="Xem thêm" title="Xem thêm"></a>
      </div>
    </section>

    <!-- ===== UI DESIGN ===== -->
    <section aria-labelledby="ui-h" class="flex flex-col items-center pt-[176px] px-6 mb:flex-row-reverse mb:flex-wrap mb:gap-14 mb:px-[60px] mb:pt-[200px] mb:justify-center mb:items-start dt:grid dt:grid-cols-2">
      <h2 id="ui-h" class="sr-only">UI design</h2>
      <div class="flex flex-col items-center w-full mb:w-[479px] mb:max-w-full dt:w-full dt:max-w-[479px] dt:justify-self-start">
        <img src="/assets/images/uidesign.png" alt="UI design" class="w-[220px] max-w-full h-auto object-contain mb:w-full mb:h-[400px]" loading="lazy">
        <p class="text-body-loose text-pretty text-left mt-8 mb:text-body mb:text-justify mb:mt-10">Mình có khoảng 3 năm kinh nghiệm thiết kế UI, từng có cơ hội làm việc với TikTok, các thương hiệu nhỏ và trong một công ty Nhật Bản. Mình có kinh nghiệm trao đổi trực tiếp với khách hàng và phối hợp với các nhóm đa chức năng.</p>
        <a href="/vi/ui-design" class="img-btn block w-[138px] h-[64px] mx-auto mt-8 hidden dt:block" style="background-image:url(/assets/images/readmore.png)" aria-label="Xem thêm" title="Xem thêm"></a>
      </div>
      <div class="w-full max-w-[320px] mt-10 mb:w-[632px] mb:max-w-full mb:mt-0 dt:w-full">
        <div class="grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8">
          <a href="/vi/tiktok-camp" class="block group"><img src="/assets/images/projects/tiktok-camp/thumb.webp" alt="Chiến dịch TikTok - UI design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Chiến dịch TikTok - UI design</div></a>
          <a href="/vi/top-member-page" class="block group"><img src="/assets/images/projects/top-member-page/thumb.webp" alt="Trang chủ thành viên - LP design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Trang chủ thành viên - LP design</div></a>
          <a href="/vi/offshore" class="block group"><img src="/assets/images/projects/offshore/thumb.webp" alt="Offshore - LP design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Offshore - LP design</div></a>
          <a href="/vi/lucky-money" class="block group"><img src="/assets/images/projects/lucky-money/thumb.webp" alt="Lucky money - LP design" width="600" height="442" class="block w-full aspect-square object-cover rounded-[6px] bg-[#f4f4f4]" loading="lazy" decoding="async"><div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">Lucky money - LP design</div></a>
        </div>
        <a href="/vi/ui-design" class="img-btn block w-[138px] h-[64px] mx-auto mt-6 mb:mt-8 dt:hidden" style="background-image:url(/assets/images/readmore.png)" aria-label="Xem thêm" title="Xem thêm"></a>
      </div>
    </section>

    <!-- ===== CONTACT TEASER ===== -->
    <section aria-labelledby="contact-h" class="pt-[200px] flex flex-col items-center">
      <h2 id="contact-h" class="sr-only">Contact</h2>
      <img src="/assets/images/contact.png" alt="Contact" class="w-[280px] max-w-[60%] mb:w-[340px] mb:max-w-full dt:w-[387px] h-auto object-contain" loading="lazy">
      <p class="mt-12 max-w-[880px] px-6 text-center font-normal text-[16px] leading-6 text-pretty">Chào bạn, mình là Thúy An, một illustrator và UI designer yêu thích việc vẽ, thiết kế và biến ý tưởng thành những điều mọi người có thể tận hưởng. Mình luôn tò mò, luôn sáng tạo và luôn tìm kiếm một câu chuyện mới để kể.<br><br><strong>Cùng nhau tạo nên điều gì đó thật hay nhé. Bạn có ý tưởng? Mình rất muốn được lắng nghe!<br>Email : <a href="mailto:nguyenan19495@gmail.com" class="underline">nguyenan19495@gmail.com</a></strong></p>
      <div class="h-[79px]" aria-hidden="true"></div>
    </section>
  
</BaseLayout>
