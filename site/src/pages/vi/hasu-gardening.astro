---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Hasu làm vườn | Thuy An Portfolio";

const description = "This ehon book is part of a series of 4 books that revolve around the boy named Hasu and his adventures. The content of this book was edited by Trang ";

const ogImage = "/assets/images/work/99641c8a559e.webp";
---
<BaseLayout lang="vi" page="hasu-gardening" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/99641c8a559e.webp" alt="Cover" width="1766" height="1796" class="block w-full h-[240px] mb:h-[360px] dt:h-[460px] object-cover object-center" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Hasu doing gardening - 2019</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">Minh hoạ : Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">Cuốn ehon này thuộc bộ 4 cuốn xoay quanh cậu bé tên Hasu và những chuyến phiêu lưu của cậu. Phần nội dung do Trang Kyu biên tập, còn mình phụ trách phần minh hoạ.</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/11aff4210130.webp" alt="Artwork 1" width="1184" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/4985ed146357.webp" alt="Artwork 2" width="1176" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/bede46b659a3.webp" alt="Artwork 3" width="1135" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/5176bb3bce74.webp" alt="Artwork 4" width="1143" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/a110ab7512d7.webp" alt="Artwork 5" width="1128" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/3c63dfb426a4.webp" alt="Artwork 6" width="1200" height="1126" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/d4d853a2a0d6.webp" alt="Artwork 7" width="1200" height="1174" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/8b00139a1547.webp" alt="Artwork 8" width="1133" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/4cfef5cbf01e.webp" alt="Artwork 9" width="1147" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/a711f1a8df47.webp" alt="Artwork 10" width="1132" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/9c2b14f783df.webp" alt="Artwork 11" width="1145" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/17758fcf1327.webp" alt="Artwork 12" width="1162" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">
        <img src="/assets/images/work/b9d212a2b70a.webp" alt="Closing illustration" width="1200" height="978" class="block w-[200px] h-[200px] mb:w-[250px] mb:h-[250px] rounded-full object-cover object-center mx-auto" loading="lazy" decoding="async">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>
  
</BaseLayout>
