---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Đóa hoa đồng thoại - minh họa trang sách | Thuy An Portfolio";

const description = "Minh họa trang sách cho các câu chuyện thiếu nhi trong tuyển tập \"Đóa hoa đồng thoại\".";

const ogImage = "/assets/images/projects/doa-hoa-dong-thoai/thumb.webp";
---
<BaseLayout lang="vi" page="doa-hoa-dong-thoai" title={title} description={description} ogImage={ogImage} divider={true}>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Đóa hoa đồng thoại - minh họa trang sách</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">Minh họa : Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words max-w-[900px]">Minh họa trang sách cho các câu chuyện thiếu nhi trong tuyển tập "Đóa hoa đồng thoại".</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="grid grid-cols-1 gap-10 mb:gap-[50px] items-start">
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/doa-hoa-dong-thoai/s01.webp" alt="Câu chuyện của Cục Lười Biếng" width="4026" height="2518" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/doa-hoa-dong-thoai/s02.webp" alt="Món quà mùa đông dành cho cô chủ nhỏ" width="4018" height="2520" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full max-w-[1000px] mx-auto"><img src="/assets/images/projects/doa-hoa-dong-thoai/s03.webp" alt="Số 0 trốn đi đâu" width="4554" height="2854" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
      </section>

      <div class="mt-[60px] flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>

</BaseLayout>
