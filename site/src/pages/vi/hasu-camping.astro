---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "Hasu đi cắm trại | Thuy An Portfolio";
const description = "This ehon book is part of a series of 4 books that revolve around the boy named Hasu and his adventures. The content of this book was edited by Trang ";
const ogImage = "/assets/images/work/cc804a71e720.webp";
---
<BaseLayout lang="vi" page="hasu-camping" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/cc804a71e720.webp" alt="Cover" width="1776" height="1408" class="block w-full h-[240px] mb:h-[360px] dt:h-[460px] object-cover object-center" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Hasu goes camping - 2019</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">Minh hoạ : Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">Cuốn ehon này thuộc bộ 4 cuốn xoay quanh cậu bé tên Hasu và những chuyến phiêu lưu của cậu. Phần nội dung do Trang Kyu biên tập, còn mình phụ trách phần minh hoạ.</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/e7971df97b21.webp" alt="Artwork 1" width="1166" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/b3fbc57687f4.webp" alt="Artwork 2" width="1169" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/23f9b1b3edc3.webp" alt="Artwork 3" width="1184" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/f9c0bbac3d99.webp" alt="Artwork 4" width="1200" height="1194" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/390781f1015d.webp" alt="Artwork 5" width="1124" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/1914ae4e4159.webp" alt="Artwork 6" width="1181" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/2c00d10113f0.webp" alt="Artwork 7" width="1168" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/a01145e3b9b2.webp" alt="Artwork 8" width="1200" height="1116" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/4bf270587ff7.webp" alt="Artwork 9" width="1200" height="1181" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/ffb6afaf4e25.webp" alt="Artwork 10" width="1200" height="1126" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/d4625abd2091.webp" alt="Artwork 11" width="1200" height="1161" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/493a53a3509d.webp" alt="Artwork 12" width="1193" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/ef5583e60895.webp" alt="Artwork 13" width="1191" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/2668d75a9081.webp" alt="Artwork 14" width="1180" height="1200" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">
        <img src="/assets/images/work/7df3f561e7b7.webp" alt="Closing illustration" width="800" height="906" class="block w-[200px] h-[200px] mb:w-[250px] mb:h-[250px] rounded-full object-cover object-center mx-auto" loading="lazy" decoding="async">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>
  
</BaseLayout>
