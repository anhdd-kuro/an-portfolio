---
import BaseLayout from '../../layouts/BaseLayout.astro';
const title = "kaeru sticker | Thuy An Portfolio";
const description = "This is a project that I worked on while at Caeruxlab company.";
const ogImage = "/assets/images/work/19208a312a4f.webp";
---
<BaseLayout lang="vi" page="kaeru-sticker" title={title} description={description} ogImage={ogImage} divider={true}>

    <div class="w-full"><img src="/assets/images/work/19208a312a4f.webp" alt="Cover" width="2560" height="450" class="block w-full h-auto" fetchpriority="high" decoding="async"></div>

    <article class="px-6 mb:px-16 dt:px-[140px] pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">kaeru sticker</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty break-words">Đây là dự án mình thực hiện trong thời gian làm việc tại công ty Caeruxlab.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Hạng mục : Thiết kế sticker<br>Khách hàng : Caeruxlab<br>Công cụ : Adobe Illustrator, Procreate</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-[50px] items-start">
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/7fb0f2c5281a.webp" alt="Artwork 1" width="2000" height="1767" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="dt:col-span-2 mx-auto w-full max-w-[1000px]"><img src="/assets/images/work/db327b4a4f72.webp" alt="Artwork 2" width="2000" height="1811" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/b1905fee73c5.webp" alt="Artwork 3" width="1400" height="2104" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        <div class="w-full mx-auto max-w-[490px]"><img src="/assets/images/work/734c34470211.webp" alt="Artwork 4" width="1400" height="2108" class="block w-full h-auto rounded-[6px]" loading="lazy" decoding="async"></div>
        </div>
        </section>

      <div class="mt-[72px] mb:mt-[88px] flex flex-col items-center gap-10 mb:gap-11">

        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/illustration" id="back-link" class="img-btn block w-[136px] h-[26px] mt-[68px] mb-[84px] !bg-left" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>
  
</BaseLayout>
