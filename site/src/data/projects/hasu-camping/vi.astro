---
import OptimizedImage from "../../../components/OptimizedImage.astro";
---
<div class="w-full"><OptimizedImage src="/assets/images/work/cc804a71e720.webp" alt="Ảnh bìa" width="1776" height="1408" class="block w-full h-60 mb:h-90 dt:h-115 object-cover object-center" fetchpriority="high" decoding="async" /></div>

    <article class="px-6 mb:px-16 dt:px-35 pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Hasu đi cắm trại - 2019</h1>
        <p class="mt-3 text-[18px] leading-6 font-medium">Minh hoạ : Thuy An</p>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty wrap-break-word">Cuốn ehon này thuộc bộ 4 cuốn xoay quanh cậu bé tên Hasu và những chuyến phiêu lưu của cậu. Phần nội dung do Trang Kyu biên tập, còn mình phụ trách phần minh hoạ.</p>

      <section class="mt-14 mb:mt-16" aria-label="Tác phẩm">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="grid grid-cols-1 dt:grid-cols-2 gap-10 mb:gap-12.5 items-start">
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/e7971df97b21.webp" alt="Tác phẩm 1" width="1166" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/b3fbc57687f4.webp" alt="Tác phẩm 2" width="1169" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/23f9b1b3edc3.webp" alt="Tác phẩm 3" width="1184" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/f9c0bbac3d99.webp" alt="Tác phẩm 4" width="1200" height="1194" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/390781f1015d.webp" alt="Tác phẩm 5" width="1124" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/1914ae4e4159.webp" alt="Tác phẩm 6" width="1181" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/2c00d10113f0.webp" alt="Tác phẩm 7" width="1168" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/a01145e3b9b2.webp" alt="Tác phẩm 8" width="1200" height="1116" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/4bf270587ff7.webp" alt="Tác phẩm 9" width="1200" height="1181" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/ffb6afaf4e25.webp" alt="Tác phẩm 10" width="1200" height="1126" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/d4625abd2091.webp" alt="Tác phẩm 11" width="1200" height="1161" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/493a53a3509d.webp" alt="Tác phẩm 12" width="1193" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/ef5583e60895.webp" alt="Tác phẩm 13" width="1191" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full mx-auto max-w-122.5"><OptimizedImage src="/assets/images/work/2668d75a9081.webp" alt="Tác phẩm 14" width="1180" height="1200" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        </div>
        </section>

      <div class="mt-18 mb:mt-22 flex flex-col items-center gap-10 mb:gap-11">
        <OptimizedImage src="/assets/images/work/7df3f561e7b7.webp" alt="Minh họa kết thúc" width="800" height="906" class="block w-50 h-50 mb:w-62.5 mb:h-62.5 rounded-full object-cover object-center mx-auto" loading="lazy" decoding="async" />
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/illustration" id="back-link" class="img-btn block w-34 h-6.5 mt-17 mb-21 bg-left!" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>
