---
import OptimizedImage from "../../../components/OptimizedImage.astro";
---
<div class="w-full"><OptimizedImage src="/assets/images/projects/offshore/cover.webp" alt="Cover" width="2400" height="1768" class="block w-full h-auto" fetchpriority="high" decoding="async" /></div>

    <article class="px-6 mb:px-16 dt:px-35 pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Offshore - LP design</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty wrap-break-word max-w-225">This is a project that I worked on while at Caeruxlab company.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Category : LP mobile design<br>Client : Caeruxlab<br>Tool used : Adobe XD</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 gap-10 mb:gap-12.5 items-start">
        <div class="w-full max-w-250 mx-auto"><OptimizedImage src="/assets/images/projects/offshore/01.webp" alt="Screen 1" width="2400" height="1768" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        </div>
      </section>

      <div class="mt-15 flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/ui-design" id="back-link" class="img-btn block w-34 h-6.5 mt-17 mb-21 bg-left!" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
