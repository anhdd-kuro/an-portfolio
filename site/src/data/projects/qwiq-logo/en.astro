---
import OptimizedImage from "../../../components/OptimizedImage.astro";
---
<article class="px-6 mb:px-16 dt:px-35 pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">Qwiq logo</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty wrap-break-word max-w-225">Logo design for QwiQ - Karabiner company.</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Category : Logo design<br>Client : QwiQ - Karabiner company<br>Tool used : Adobe XD, Adobe illustrator</p>

      <section class="mt-14 mb:mt-16" aria-label="Artwork">
        <h2 class="sr-only">Artwork</h2>
        <div class="grid grid-cols-1 gap-10 mb:gap-12.5 items-start">
        <div class="w-full max-w-250 mx-auto"><OptimizedImage src="/assets/images/projects/qwiq-logo/s01.webp" alt="QwiQ logo design board" width="2000" height="3313" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        <div class="w-full max-w-122.5 mx-auto"><OptimizedImage src="/assets/images/projects/qwiq-logo/s02.webp" alt="QwiQ icon logo" width="822" height="800" class="block w-full h-auto rounded-md" loading="lazy" decoding="async" /></div>
        </div>
      </section>

      <div class="mt-15 flex flex-col items-center gap-8">
        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Thanks for watching!</p>
      </div>

      <a href="/en/ui-design" id="back-link" class="img-btn block w-34 h-6.5 mt-17 mb-21 bg-left!" style="background-image:url(/assets/icons/back.png)" aria-label="Back" title="Back"></a>
    </article>
