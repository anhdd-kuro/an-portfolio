---
import OptimizedImage from "../../../components/OptimizedImage.astro";
---
<div class="w-full"><OptimizedImage src="/assets/images/projects/ketnoi/cover.webp" alt="Cover" width="2560" height="1682" class="block w-full h-auto" fetchpriority="high" decoding="async" /></div>

    <article class="px-6 mb:px-16 dt:px-35 pt-10">
      <header>
        <h1 class="font-extrabold text-2xl mb:text-[32px] leading-10">ketnoi LP design</h1>
      </header>
      <p class="mt-5 text-[16px] leading-6 font-normal text-pretty wrap-break-word max-w-225">Corporate landing page for KET NOI, designed for desktop and mobile.<br>(Placeholder text, to be updated.)</p>
      <p class="mt-5 text-[16px] leading-6 font-medium">Category : LP design (PC / SP)<br>Client : (to be updated)<br>Tool used : (to be updated)</p>

      <section class="mt-14 mb:mt-16" aria-label="Screens">
        <h2 class="sr-only">Tác phẩm</h2>
        <div class="mt-8 grid grid-cols-1 gap-10 mb:gap-12.5 items-start">
          <div class="w-full mx-auto rounded-md overflow-hidden" style="max-width:1000px">
    <OptimizedImage src="/assets/images/projects/ketnoi/s01.webp" alt="Screen 1" width="2560" height="1682" class="block w-full h-auto" loading="lazy" decoding="async" />
  </div>
          <div class="w-full mx-auto rounded-md overflow-hidden" style="max-width:1000px">
    <OptimizedImage src="/assets/images/projects/ketnoi/s02.webp" alt="Screen 2" width="2560" height="1682" class="block w-full h-auto" loading="lazy" decoding="async" />
  </div>
          <div class="w-full mx-auto rounded-md overflow-hidden" style="max-width:1000px">
    <OptimizedImage src="/assets/images/projects/ketnoi/s03.webp" alt="Screen 3" width="2560" height="1682" class="block w-full h-auto" loading="lazy" decoding="async" />
  </div>
          <div class="w-full mx-auto rounded-md overflow-hidden" style="max-width:1000px">
    <OptimizedImage src="/assets/images/projects/ketnoi/s04.webp" alt="Screen 4" width="2560" height="1682" class="block w-full h-auto" loading="lazy" decoding="async" />
  </div>
          <div class="w-full mx-auto rounded-md overflow-hidden" style="max-width:1000px">
    <OptimizedImage src="/assets/images/projects/ketnoi/s05.webp" alt="Screen 5" width="2560" height="1682" class="block w-full h-auto" loading="lazy" decoding="async" />
  </div>
          <div class="w-full mx-auto rounded-md overflow-hidden" style="max-width:1000px">
    <OptimizedImage src="/assets/images/projects/ketnoi/s06.webp" alt="Screen 6" width="2560" height="1682" class="block w-full h-auto" loading="lazy" decoding="async" />
  </div>
        </div>
      </section>

      <div class="mt-15 flex flex-col items-center gap-8">

        <p class="font-extrabold text-2xl mb:text-[32px] leading-10 text-center">Cảm ơn bạn đã xem!</p>
      </div>

      <a href="/vi/ui-design" id="back-link" class="img-btn block w-34 h-6.5 mt-17 mb-21 bg-left!" style="background-image:url(/assets/icons/back.png)" aria-label="Quay lại" title="Quay lại"></a>
    </article>
