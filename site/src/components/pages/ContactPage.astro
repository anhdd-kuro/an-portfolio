---
import type { CollectionEntry } from "astro:content";
import OptimizedImage from "../OptimizedImage.astro";

type ContactPageData = Extract<CollectionEntry<"pages">["data"], { kind: "contact" }>;

interface Props {
  content: ContactPageData;
}

const { content } = Astro.props;
---

<section class="px-6 mb:px-16 dt:px-35 pt-8 mb:pt-11.5 flex flex-col items-center">
  <h1 class="sr-only">{content.heading}</h1>
  <OptimizedImage src="/assets/images/contact.png" alt={content.heading} class="block h-44.5 mb:h-81 w-auto max-w-full object-contain" width="895" height="837" />
  <p class="mt-12 max-w-220 text-center mb:text-left font-normal text-[16px] leading-5 text-pretty" set:html={content.body} />
  <div class="mt-7 flex gap-8">
    <a href="https://www.facebook.com/vuive194/" target="_blank" rel="noopener" class="img-btn block w-11.75 h-12" style="background-image:url(/assets/icons/fb.png)" aria-label="Facebook"></a>
    <a href="https://www.instagram.com/thuyan.illustration/" target="_blank" rel="noopener" class="img-btn block w-11.75 h-12" style="background-image:url(/assets/icons/instagram.png)" aria-label="Instagram"></a>
  </div>
  <div class="h-25 mb:h-39.5" aria-hidden="true"></div>
</section>
