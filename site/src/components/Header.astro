---
import OptimizedImage from './OptimizedImage.astro';
import { localeEntries, localizedPath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

export interface Props {
  lang: Locale;
  page: string; // 'home' or the bare page slug (no .html)
}

const { lang, page } = Astro.props;

const t = useTranslations(lang);

const hrefFor = (targetLang: Locale, slug = page) => localizedPath(targetLang, slug);

const LANGUAGE_HIT_AREAS = {
  en: { top: '4.9738%', height: '30.2356%' },
  ja: { top: '35.2094%', height: '30.3665%' },
  vi: { top: '65.5759%', height: '28.1414%' },
};

const languages = localeEntries.map((entry) => ({
  ...entry,
  ...LANGUAGE_HIT_AREAS[entry.locale],
}));
---
<header class="relative">
  <div class="header-bar h-15 mb:h-25 flex items-center gap-4 px-4 mb:gap-6 mb:px-6">
    <a href={hrefFor(lang, 'home')} class="shrink-0 block h-15 w-15 mb:h-25 mb:w-25" title={t('nav.home')} aria-label={t('nav.home')}>
      <OptimizedImage src="/assets/images/logo.png" alt="Thuy An" class="h-full w-full object-contain" width="100" height="100" />
    </a>

    <!-- Desktop / tablet nav -->
    <nav class="header-nav hidden mb:flex min-w-0 flex-1 items-center justify-end gap-5 dt:gap-8" aria-label="Main">
      <a href={hrefFor(lang, 'about')} class="shrink-0 h-16 dt:h-20 img-btn" title={t('nav.about')} aria-label={t('nav.about')}><OptimizedImage src="/assets/images/nav-aboutme.png" alt="" class="h-full w-auto" height="80" /></a>
      <a href={hrefFor(lang, 'illustration')} class="shrink-0 h-16 dt:h-20 img-btn" title={t('nav.illustration')} aria-label={t('nav.illustration')}><OptimizedImage src="/assets/images/nav-illustration.png" alt="" class="h-full w-auto" height="80" /></a>
      <a href={hrefFor(lang, 'ui-design')} class="shrink-0 h-16 dt:h-20 img-btn" title={t('nav.uidesign')} aria-label={t('nav.uidesign')}><OptimizedImage src="/assets/images/nav-uidesign.png" alt="" class="h-full w-auto" height="80" /></a>
      <a href={hrefFor(lang, 'contact')} class="shrink-0 h-16 dt:h-20 img-btn" title={t('nav.contact')} aria-label={t('nav.contact')}><OptimizedImage src="/assets/images/nav-contact.png" alt="" class="h-full w-auto" height="80" /></a>
      <a href="https://www.facebook.com/vuive194/" target="_blank" rel="noopener" class="shrink-0 w-9 h-9 dt:w-11 dt:h-11 img-btn" style="background-image:url(/assets/icons/fb.png)" aria-label="Facebook"></a>
      <a href="https://www.instagram.com/thuyan.illustration/" target="_blank" rel="noopener" class="shrink-0 w-9 h-9 dt:w-11 dt:h-11 img-btn" style="background-image:url(/assets/icons/instagram.png)" aria-label="Instagram"></a>
      <div class="lang-dd shrink-0 w-10 h-10 dt:w-12.5 dt:h-12.5">
        <button type="button" class="lang-dd-btn img-btn" style="background-image:url(/assets/icons/lang.png)" aria-haspopup="listbox" aria-expanded="false" aria-label={t('nav.lang')} title={t('nav.lang')}></button>
        <div class="lang-dd-list" role="listbox" aria-label="Language" aria-hidden="true" inert>
          <OptimizedImage src="/assets/icons/lang-panel.png" alt="" width="497" height="382" />
          {languages.map((language) => (
            <a role="option" class={`lang-btn${language.locale === lang ? ' active' : ''}`} aria-selected={language.locale === lang ? 'true' : 'false'} href={hrefFor(language.locale)} style={`top:${language.top};height:${language.height}`}><span class="sr-only">{language.label}</span></a>
          ))}
        </div>
      </div>
    </nav>

    <!-- Mobile: hamburger -->
    <button id="menu-toggle" type="button" class="mb:hidden ml-auto shrink-0 w-8 h-8 img-btn" style="background-image:url(/assets/icons/menu.png)" aria-controls="mobile-menu" aria-expanded="false" aria-label={t('nav.menu')} title={t('nav.menu')}></button>
  </div>
</header>

<!-- Mobile menu overlay -->
<div id="mobile-menu" class="mb:hidden" role="dialog" aria-modal="true" aria-label="Menu" aria-hidden="true" inert>
  <div class="menu-bar">
    <a href={hrefFor(lang, 'home')} class="menu-logo" title={t('nav.home')} aria-label={t('nav.home')}><OptimizedImage src="/assets/images/logo.png" alt="Thuy An" class="h-full w-full object-contain" width="100" height="100" /></a>
    <button id="menu-close" type="button" class="img-btn" style="background-image:url(/assets/icons/close.png)" aria-label={t('nav.close')} title={t('nav.close')}></button>
  </div>
  <nav class="menu-list" aria-label="Pages">
    <a href={hrefFor(lang, 'about')} title={t('nav.about')} aria-label={t('nav.about')}><OptimizedImage src="/assets/images/menu-about.png" alt="About me" width="256" height="264" /></a>
    <a href={hrefFor(lang, 'ui-design')} title={t('nav.uidesign')} aria-label={t('nav.uidesign')}><OptimizedImage src="/assets/images/menu-uidesign.png" alt="UI design" width="340" height="285" /></a>
    <a href={hrefFor(lang, 'illustration')} title={t('nav.illustration')} aria-label={t('nav.illustration')}><OptimizedImage src="/assets/images/menu-illustration.png" alt="Illustration" width="341" height="286" /></a>
    <a href={hrefFor(lang, 'contact')} title={t('nav.contact')} aria-label={t('nav.contact')}><OptimizedImage src="/assets/images/menu-contact.png" alt="Contact" width="288" height="277" /></a>
  </nav>
  <div class="menu-social">
    <a href="https://www.facebook.com/vuive194/" target="_blank" rel="noopener" class="img-btn" style="background-image:url(/assets/icons/fb.png)" aria-label="Facebook"></a>
    <a href="https://www.instagram.com/thuyan.illustration/" target="_blank" rel="noopener" class="img-btn" style="background-image:url(/assets/icons/instagram.png)" aria-label="Instagram"></a>
  </div>
  <div class="menu-lang" role="group" aria-label="Language">
    {languages.map((language) => (
      <a class={`lang-btn${language.locale === lang ? ' active' : ''}`} href={hrefFor(language.locale)}>{language.shortLabel}</a>
    ))}
  </div>
  <footer class="site-footer">
    <span>{t('footer.copy')}</span>
  </footer>
</div>
