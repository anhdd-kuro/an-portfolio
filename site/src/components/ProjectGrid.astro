---
import {
  getProjectCardCopy,
  getProjectsByCategory,
  type ProjectCategory,
  type ProjectLocale,
} from "../data/projects";
import { localizedPath } from "../i18n/config";
import OptimizedImage from "./OptimizedImage.astro";

interface Props {
  lang: ProjectLocale;
  category: ProjectCategory;
  limit?: number;
  variant?: "home" | "category";
}

const {
  lang,
  category,
  limit,
  variant = "category",
} = Astro.props;

const items = getProjectsByCategory(category).slice(0, limit);

const isHome = variant === "home";

const gridClass = isHome
  ? "grid grid-cols-1 gap-10 mb:grid-cols-2 mb:gap-8"
  : "grid grid-cols-1 justify-items-center mb:grid-cols-[repeat(auto-fit,300px)] mb:justify-items-stretch justify-center gap-y-15 gap-x-12.5";

const cardClass = isHome
  ? "block group"
  : "block group w-full max-w-75 mb:w-75";

const imageClass = isHome
  ? "block w-full aspect-square object-cover rounded-md bg-[#f4f4f4]"
  : "block w-full aspect-square object-cover object-center rounded-md bg-[#f4f4f4]";
---
<div class={gridClass}>
  {items.map((project) => {
    const copy = getProjectCardCopy(project, lang);

    return (
      <a href={localizedPath(lang, project.slug)} class={cardClass}>
        <OptimizedImage
          src={project.card.image.src}
          alt={copy.alt}
          width={project.card.image.width}
          height={project.card.image.height}
          class={imageClass}
          loading="lazy"
          decoding="async"
        />
        <div class="mt-3 min-h-5 flex items-center justify-center text-center text-body text-pretty">
          {copy.title}
        </div>
      </a>
    );
  })}
</div>
