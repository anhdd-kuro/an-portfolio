---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import logo from '../assets/images/logo.png';
import { htmlLangFromLocale, localeEntries, localizedPath, type Locale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { resolveImageAsset } from '../lib/image-assets';
import '../styles/global.css';

export interface Props {
  lang: Locale;
  page: string; // 'home' or bare slug, matches body[data-page] on the legacy site
  title: string;
  description: string;
  ogImage?: string;
  divider?: boolean;
}

const {
  lang,
  page,
  title,
  description,
  ogImage = '/assets/images/logo.png',
  divider = true,
} = Astro.props;

const t = useTranslations(lang);

const htmlLang = htmlLangFromLocale(lang);

const ogImageUrl = resolveImageAsset(ogImage)?.src ?? ogImage;
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImageUrl} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" type="image/png" href={logo.src} />
  <Font cssVariable="--font-quicksand" preload />
  {htmlLang === 'ja' && <Font cssVariable="--font-hina-mincho" />}
  {localeEntries.map((locale) => (
    <link rel="alternate" hreflang={locale.htmlLang} href={localizedPath(locale.locale, page)} />
  ))}
  <link rel="alternate" hreflang="x-default" href={localizedPath('en', page)} />
</head>
<body data-page={page} class:list={[htmlLang === 'ja' ? 'font-jp' : 'font-serif', 'text-ink', 'bg-paper']}>
<div class="w-full max-w-7xl mx-auto bg-paper min-h-screen flex flex-col overflow-x-hidden">

  <Header lang={lang} page={page} />

  {divider && <div class="divider" role="presentation"></div>}

  <main class="flex-1">
    <slot />
  </main>

  <footer class="site-footer">
    <span>{t('footer.copy')}</span>
  </footer>
</div>
<a href="#" id="side-scroll" title={t('nav.scroll')} aria-label={t('nav.scroll')} data-scroll-label={t('nav.scroll')} data-totop-label={t('nav.totop')}><span class="sr-only">{t('nav.scroll')}</span></a>
<script src="../scripts/main.js"></script>
</body>
</html>
